    "Shown on your bike computer's sensor list. The Bluetooth advertising packet is only 31 bytes, so this is capped at 10 characters.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يظهر في قائمة أجهزة الاستشعار بجهاز الكمبيوتر الخاص بالدراجة. حزمة الإعلان عبر البلوتوث لا تتجاوز 31 بايتًا، لذا تم تحديد هذا الحقل بـ 10 أحرف كحد أقصى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zobrazeno na seznamu senzorů vašeho cyklopočítače. Paket Bluetooth advertising má pouze 31 bajtů, takže je omezen na 10 znaků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vises på din cycomputer-sensorliste. Bluetooth-reklamepakken er kun 31 bytes, så dette er begrænset til 10 tegn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In der Sensorenliste Ihres Fahrradcomputers angezeigt. Das Bluetooth-Werbe-Paket ist nur 31 Bytes groß, daher ist dies auf 10 Zeichen beschränkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se muestra en la lista de sensores de tu ordenador de ciclismo. El paquete de publicidad Bluetooth solo tiene 31 bytes, por lo que se limita a 10 caracteres."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se muestra en la lista de sensores de tu computadora de ciclismo. El paquete de publicidad Bluetooth solo tiene 31 bytes, por lo que esto se limita a 10 caracteres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Näytetään pyörätietokoneen anturilistalla. Bluetooth-mainospaketti on vain 31 tavua, joten tämä on rajoitettu 10 merkkiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affiché dans la liste des capteurs de votre ordinateur de vélo. Le paquet de publicité Bluetooth ne fait que 31 octets, donc cela est limité à 10 caractères."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ditampilkan dalam daftar sensor pada komputer sepeda Anda. Paket iklan Bluetooth hanya berukuran 31 byte, sehingga dibatasi hingga 10 karakter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visualizzato nell'elenco dei sensori del tuo computer da ciclismo. Il pacchetto di pubblicità Bluetooth è lungo solo 31 byte, quindi il limite è di 10 caratteri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "バイクコンピュータのセンサーリストに表示されます。Bluetoothアドバタイジングパケットは31バイトのみであるため、10文字に制限されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "자전거 컴퓨터의 센서 목록에 표시됩니다. Bluetooth 광고 패킷은 31바이트이므로 이 값은 10자로 제한됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vises på sensortesten til syklerdatamaskinen din. Bluetooth-reklamepakken er kun 31 byte, så dette er begrenset til 10 tegn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Weergegeven in de sensorenlijst van je fietscomputer. Het Bluetooth-advertentiepakket is slechts 31 bytes, dus dit is beperkt tot 10 tekens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyświetlane na liście czujników komputera rowerowego. Pakiet reklamowy Bluetooth ma tylko 31 bajtów, więc limit wynosi 10 znaków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exibido na lista de sensores do seu computador de ciclismo. O pacote de anúncio Bluetooth tem apenas 31 bytes, portanto, isso é limitado a 10 caracteres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отображается в списке датчиков вашего велокомпьютера. Пакет рекламы Bluetooth имеет длину всего 31 байт, поэтому здесь ограничение составляет 10 символов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visas i din cykldators sensorlista. Bluetooth-reklamdatapaketet är endast 31 byte, så detta är begränsat till 10 tecken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แสดงในรายการเซ็นเซอร์ของเครื่องคอมพิวเตอร์จักรยานของคุณ แพ็กเก็ตโฆษณา Bluetooth มีขนาดเพียง 31 ไบต์ ดังนั้นจึงจำกัดไว้ที่ 10 ตัวอักษร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bisiklet bilgisayarınızın sensör listesinde gösterilir. Bluetooth reklam paketi yalnızca 31 bayt olduğundan, bu 10 karakterle sınırlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відображається у списку датчиків вашого велокомп’ютера. Оскільки пакет реклами Bluetooth має розмір лише 31 байт, тут ліміт становить 10 символів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiển thị trong danh sách cảm biến của máy tính xe đạp của bạn. Gói quảng bá Bluetooth chỉ có 31 byte, vì vậy giới hạn tối đa là 10 ký tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "显示在自行车电脑传感器列表中。由于蓝牙广播数据包仅有 31 字节，因此此处限制为 10 个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "顯示在自行車電腦的感應器清單中。Bluetooth 廣播封包僅有 31 位元組，因此這裡限制為 10 個字元。"
          }
        }
      }
    },
