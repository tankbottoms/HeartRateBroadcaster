    "Power, cadence and trainer sensors, your body details for the calorie figure, and every session you have saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستشعرات القدرة ومعدل الدوران وجهاز التدريب، وبيانات جسمك لحساب السعرات، وكل جلسة حفظتها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímače výkonu, kadence a trenažéru, vaše tělesné údaje pro výpočet kalorií a všechny uložené tréninky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensorer for effekt, kadence og hometrainer, dine kropsdata til kalorieberegningen og alle gemte træninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensoren für Leistung, Trittfrequenz und Rollentrainer, deine Körperdaten für den Kalorienwert und alle gesicherten Einheiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensores de potencia, cadencia y rodillo, tus datos corporales para el cálculo de calorías y todas las sesiones guardadas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensores de potencia, cadencia y rodillo, tus datos corporales para el cálculo de calorías y todas las sesiones guardadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teho-, poljinnopeus- ja rullatrenaserianturit, kehon tiedot kalorilaskentaa varten sekä kaikki tallennetut harjoitukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capteurs de puissance, de cadence et home-trainer, vos données corporelles pour le calcul des calories, et toutes les séances enregistrées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor daya, kadensa, dan trainer, data tubuh Anda untuk perhitungan kalori, serta semua sesi yang tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensori di potenza, cadenza e rullo, i tuoi dati corporei per il calcolo delle calorie e tutte le sessioni salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パワー・ケイデンス・スマートトレーナーのセンサー、カロリー計算に使う身体情報、保存済みのすべてのセッション。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파워·케이던스·트레이너 센서, 칼로리 계산에 쓰이는 신체 정보, 저장한 모든 세션."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensorer for effekt, kadens og rulleapparat, kroppsdataene dine til kaloriberegningen og alle lagrede økter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermogens-, cadans- en trainersensoren, je lichaamsgegevens voor het calorieënaantal en alle bewaarde sessies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czujniki mocy, kadencji i trenażera, dane ciała do obliczania kalorii oraz wszystkie zapisane sesje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensores de potência, cadência e rolo, seus dados corporais para o cálculo de calorias e todas as sessões salvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Датчики мощности, каденса и станка, данные о теле для расчёта калорий и все сохранённые сессии."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensorer för effekt, kadens och trainer, dina kroppsuppgifter för kaloriberäkningen och alla sparade pass."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซ็นเซอร์กำลัง รอบขา และเทรนเนอร์ ข้อมูลร่างกายสำหรับคำนวณแคลอรี และทุกเซสชันที่คุณบันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güç, kadans ve biniş sehpası sensörleri, kalori hesabı için vücut bilgileriniz ve kaydettiğiniz tüm seanslar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Датчики потужності, каденсу й велостанка, дані про тіло для розрахунку калорій і всі збережені сесії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm biến công suất, guồng chân và bàn đạp tập, thông số cơ thể dùng để tính calo, và mọi buổi tập bạn đã lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "功率、踏频与骑行台传感器，用于计算卡路里的身体数据，以及你保存的每一次训练。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "功率、踏頻與訓練台感應器，用於計算卡路里的身體數據，以及你儲存的每一次訓練。"
          }
        }
      }
    },
