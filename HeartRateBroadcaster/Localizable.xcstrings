          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saat + AirPods"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Годинник + AirPods"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đồng hồ + AirPods"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手表 + AirPods"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手錶 + AirPods"
          }
        }
      }
    },
    "Watch + AirPods reads both sensors and broadcasts a single reconciled value — when they agree it sends their average, and when they disagree it drops whichever one has strayed from the trend. Your head unit always sees exactly one sensor. Test Signal generates a heart rate on the phone itself; if the head unit shows that but not your watch, the problem is the watch link, not Bluetooth.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تقرأ الساعة + سماعات AirPods كلا المستشعرين وتنشر قيمة واحدة متوافقة — عندما يتفقان، ترسل متوسطهما، وعندما يختلفان، تتجاهل القيمة التي انحرفت عن الاتجاه العام. ترى وحدة الرأس الخاصة بك مستشعرًا واحدًا فقط. يولّد اختبار الإشارة معدل ضربات القلب على الهاتف نفسه؛ إذا أظهرت وحدة الرأس هذه القيمة ولكن ليس ساعتك، فالمشكلة في ارتباط الساعة، وليس في البلوتوث."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplikace Watch + AirPods čte oba senzory a vysílá jednu sloučenou hodnotu – když se shodují, odesílá jejich průměr, a když se neshodují, vynechá tu, která se nejvíce odchýlí od trendu. Vaše přijímací jednotka vždy vidí právě jeden senzor. Test Signálu generuje tepovou frekvenci přímo v telefonu; pokud přijímací jednotka zobrazuje tuto hodnotu, ale ne z hodinek, problém je ve spojení s hodinkami, nikoliv v Bluetooth."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods læser begge sensorer og udsender en enkelt forliget værdi — når de er enige, sender de deres gennemsnit, og når de er uenige, dropper den den, der har afviget fra trenden. Din hovedenhed ser altid præcis én sensor. Test Signal genererer en puls på selve telefonen; hvis hovedenheden viser det, men ikke dit ur, er problemet urforbindelsen, ikke Bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods liest beide Sensoren aus und sendet einen einzigen abgeglichenen Wert – wenn sie übereinstimmen, wird ihr Durchschnitt gesendet, und wenn sie abweichen, wird derjenige verworfen, der vom Trend abgewichen ist. Dein Headset sieht immer genau einen Sensor. Test Signal generiert eine Herzfrequenz direkt auf dem iPhone; wenn das Headset diese anzeigt, deine Uhr aber nicht, liegt das Problem an der Verbindung zur Uhr und nicht an Bluetooth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods lee ambos sensores y transmite un único valor reconciliado: cuando coinciden, envía su promedio; cuando no coinciden, descarta el que se haya desviado de la tendencia. Tu unidad principal siempre ve exactamente un sensor. Test Signal genera una frecuencia cardíaca en el propio teléfono; si la unidad principal muestra esa frecuencia pero no la del reloj, el problema está en la conexión del reloj, no en Bluetooth."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods lee ambos sensores y transmite un único valor reconciliado: cuando coinciden, envía su promedio; cuando no coinciden, descarta el que se haya desviado de la tendencia. Tu unidad principal siempre ve exactamente un sensor. Test Signal genera una frecuencia cardíaca en el propio teléfono; si la unidad principal muestra esa lectura pero no la de tu reloj, el problema es la conexión del reloj, no Bluetooth."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods lukee molemmat anturit ja lähettää yhden sovitetun arvon — kun ne ovat samoja, se lähettää niiden keskiarvon, ja kun ne poikkeavat toisistaan, se hylkää sen arvon, joka on poikennut trendistä. Pääyksikkö näkee aina tasan yhden anturin. Testisignaali luo syketahdin itse puhelimeen; jos pääyksikkö näyttää sen, mutta ei kelloa, ongelma on kellon yhteys, ei Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods lit les deux capteurs et diffuse une valeur unique réconciliée : lorsqu’ils sont d’accord, il envoie leur moyenne ; en cas de désaccord, il ignore celui qui s’écarte de la tendance. Votre unité principale voit toujours exactement un capteur. Test Signal génère une fréquence cardiaque directement sur le téléphone ; si l’unité principale affiche cette valeur mais pas celle de votre montre, le problème vient de la connexion avec la montre, et non de Bluetooth."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods membaca kedua sensor dan memancarkan satu nilai yang telah direkonsiliasi — ketika keduanya setuju, ia mengirimkan rata-ratanya, dan ketika tidak setuju, ia membuang salah satu yang menyimpang dari tren. Unit kepala Anda selalu melihat tepat satu sensor. Sinyal Uji menghasilkan detak jantung di ponsel itu sendiri; jika unit kepala menampilkan itu tetapi bukan dari jam tangan Anda, masalahnya ada pada tautan jam tangan, bukan Bluetooth."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods legge entrambi i sensori e trasmette un unico valore riconciliato: quando sono d'accordo invia la loro media, e quando sono in disaccordo scarta quello che si discosta dalla tendenza. Il tuo dispositivo di testa vede sempre esattamente un sensore. Test Signal genera un battito cardiaco direttamente sul telefono; se il dispositivo di testa mostra quello ma non quello dell'orologio, il problema è il collegamento con l'orologio, non Bluetooth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods は両方のセンサーを読み取り、1 つの統合された値をブロードキャストします。両方が一致している場合は平均値を送信し、不一致の場合はトレンドから外れた方の値を除外します。ヘッドユニットには常に 1 つのセンサーのみが表示されます。テスト信号は iPhone 自体で心拍数を生成します。ヘッドユニットにその値が表示されるが、Apple Watch の値が表示されない場合は、問題の原因は Bluetooth ではなく Watch のリンクにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods는 두 센서를 모두 읽어서 단일 조정된 값을 방송합니다. 두 값이 일치하면 평균을 보내고, 불일치하면 추세에서 벗어난 값을 제외합니다. 헤드셋은 항상 하나의 센서만 확인합니다. 테스트 신호는 iPhone 자체에서 심박수를 생성합니다. 헤드셋에서 이 값은 표시되지만 시계에서는 표시되지 않는다면, 문제는 Bluetooth가 아닌 시계 연결입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods leser begge sensorne og sender én forenklet verdi — når de er enige, sender de gjennomsnittet, og når de er uenige, dropper den som har avviket fra trenden. Hovedenheten din ser alltid nøyaktig én sensor. Test Signal genererer en puls på selve telefonen; hvis hovedenheten viser dette, men ikke klokken din, er problemet koblingen til klokken, ikke Bluetooth."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods leest beide sensoren uit en zendt één gecorrigeerde waarde uit — wanneer ze het eens zijn, wordt het gemiddelde verzonden, en wanneer ze het niet eens zijn, wordt de sensor die afwijkt van de trend genegeerd. Je head unit ziet altijd precies één sensor. Test Signal genereert een hartslag op de telefoon zelf; als de head unit dit wel toont maar niet van je horloge, ligt het probleem bij de horlogeverbinding, niet bij Bluetooth."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods odczytuje oba czujniki i nadaje pojedynczą, ujednoliconą wartość — gdy się zgadzają, wysyła ich średnią, a gdy się różnią, odrzuca tę, która odbiega od trendu. Twoje urządzenie główne zawsze widzi dokładnie jeden czujnik. Test Signal generuje tętno bezpośrednio na telefonie; jeśli urządzenie główne pokazuje tę wartość, ale nie pokazuje jej zegarek, problem dotyczy połączenia z zegarkiem, a nie Bluetooth."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Watch + AirPods lê ambos os sensores e transmite um único valor reconciliado — quando eles concordam, ele envia a média deles; quando discordam, ele descarta aquele que se desviou da tendência. Seu dispositivo de áudio sempre vê exatamente um sensor. O Test Signal gera uma frequência cardíaca no próprio iPhone; se o dispositivo de áudio mostrar isso, mas não o do seu relógio, o problema é a conexão com o relógio, não o Bluetooth."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods считывает данные с обоих датчиков и транслирует одно согласованное значение: если показания совпадают, отправляется их среднее арифметическое, а если расходятся — отбрасывается то значение, которое отклонилось от тренда. Ваше головное устройство всегда видит только один датчик. Тестовый сигнал генерирует частоту сердечных сокращений непосредственно на телефоне; если головное устройство показывает это значение, но не показывает данные с часов, проблема в соединении с часами, а не в Bluetooth."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods läser av båda sensorerna och sänder ett enda jämnat värde — när de överensstämmer skickas deras medelvärde, och när de skiljer sig åt utelämnas den som har avvikit från trenden. Din huvudenhet ser alltid exakt en sensor. Test Signal genererar en pulssignal direkt på telefonen; om huvudenheten visar den men inte din klocka beror problemet på klockans anslutning, inte på Bluetooth."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods อ่านเซ็นเซอร์ทั้งสองตัวและส่งค่าที่ประสานกันเพียงค่าเดียว — เมื่อค่าตรงกัน จะส่งค่าเฉลี่ยของทั้งสอง และเมื่อค่าไม่ตรงกัน จะตัดค่าที่เบี่ยงเบนจากแนวโน้มออก หน่วยรับสัญญาณของคุณจะเห็นเซ็นเซอร์เพียงตัวเดียวเสมอ Test Signal จะสร้างอัตราการเต้นของหัวใจบนตัวเครื่อง iPhone เอง หากหน่วยรับสัญญาณแสดงค่านี้แต่ไม่แสดงค่าจากนาฬิกาของคุณ แสดงว่าปัญหาอยู่ที่การเชื่อมต่อนาฬิกา ไม่ใช่ Bluetooth"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods her iki sensörü okur ve tek bir uzlaştırılmış değer yayar; sensörler uyumlu olduğunda ortalamalarını gönderir, uyumsuzluk durumunda ise trendden sapana değeri yoksayar. Başlık üniteniz her zaman tam olarak bir sensör görür. Test Sinyali, telefonda kendiliğinden kalp atış hızı üretir; başlık ünitesi bunu gösteriyor ama saatinizi göstermiyorsa sorun Bluetooth değil, saat bağlantısıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods зчитує дані з обох датчиків і транслює єдине узгоджене значення — коли вони збігаються, надсилається їхнє середнє, а коли ні, той датчик, який відхилився від тренду, ігнорується. Ваша навушникова гарнітура завжди бачить лише один датчик. Тестовий сигнал генерує частоту серцевих скорочень безпосередньо на телефоні; якщо гарнітура показує це значення, але годинник ні, проблема в з’єднанні з годинником, а не в Bluetooth."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods đọc cả hai cảm biến và phát một giá trị đã được điều chỉnh — khi chúng đồng ý, nó gửi giá trị trung bình của chúng, và khi chúng không đồng ý, nó loại bỏ cảm biến nào có xu hướng lệch khỏi đường xu hướng. Đơn vị đầu của bạn luôn thấy chính xác một cảm biến. Tín hiệu thử nghiệm tạo ra nhịp tim trên chính điện thoại; nếu đơn vị đầu hiển thị điều đó nhưng không phải đồng hồ của bạn, thì vấn đề là liên kết đồng hồ, không phải Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods 会读取两个传感器并广播一个经过协调的值——当两者一致时，它会发送它们的平均值；当两者不一致时，它会丢弃偏离趋势的那个值。您的码表始终只会看到一个传感器。Test Signal 会在手机本身上生成心率；如果码表显示了该值但未显示您手表的值，则问题出在手表连接上，而非蓝牙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Watch + AirPods 會同時讀取兩個感測器，並廣播單一整合後的數值——當兩者一致時，會傳送它們的平均值；當兩者不一致時，則捨棄偏離趨勢的那一個。您的頭盔裝置永遠只會看到一個感測器。Test Signal 會在手機本身上產生心率訊號；如果頭盔裝置顯示該訊號，但沒有顯示您的手錶訊號，表示問題出在手錶連線，而非 Bluetooth。"
          }
        }
      }
    },
