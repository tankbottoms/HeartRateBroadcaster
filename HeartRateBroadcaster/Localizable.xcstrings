    "Sensors read differently because they measure at different points in the drivetrain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختلف قراءات المستشعرات لأنها تقيس عند نقاط مختلفة في نظام النقل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímače ukazují různě, protože měří na různých místech pohonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensorerne viser forskelligt, fordi de måler forskellige steder i drivlinjen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sensoren zeigen Unterschiedliches, weil sie an verschiedenen Punkten des Antriebs messen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sensores dan cifras distintas porque miden en puntos distintos de la transmisión."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sensores dan cifras distintas porque miden en puntos distintos de la transmisión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anturit näyttävät eri lukemia, koska ne mittaavat voimansiirron eri kohdista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les capteurs affichent des valeurs différentes parce qu’ils mesurent à des points différents de la transmission."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor menunjukkan angka berbeda karena mengukur di titik yang berbeda pada drivetrain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I sensori leggono valori diversi perché misurano in punti diversi della trasmissione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "センサーごとに値が異なるのは、駆動系の別々の地点で測定しているためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "센서마다 값이 다른 것은 구동계의 서로 다른 지점에서 측정하기 때문입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensorene viser ulike tall fordi de måler på ulike punkter i drivverket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensoren geven verschillende waarden omdat ze op verschillende punten in de aandrijflijn meten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czujniki pokazują różne wartości, bo mierzą w różnych punktach napędu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sensores marcam valores diferentes porque medem em pontos diferentes da transmissão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Датчики показывают по-разному, потому что измеряют в разных точках трансмиссии."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensorerna visar olika värden eftersom de mäter på olika ställen i drivlinan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซ็นเซอร์อ่านค่าต่างกันเพราะวัดคนละจุดในระบบขับเคลื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensörler farklı değerler gösterir, çünkü aktarma organlarının farklı noktalarında ölçüm yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Датчики показують по-різному, бо вимірюють у різних точках трансмісії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cảm biến đọc khác nhau vì chúng đo ở những điểm khác nhau trên hệ truyền động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各传感器读数不同，因为它们在传动系统的不同位置测量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各感應器讀數不同，因為它們在傳動系統的不同位置測量。"
          }
        }
      }
    },
