    "Heart rate permission on the watch is granted separately, on the watch, the first time its app runs.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُمنح إذن نبضات القلب على الساعة بشكل منفصل، على الساعة، في المرة الأولى التي يعمل فيها تطبيقها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přístup k tepové frekvenci na hodinkách se uděluje zvlášť, na hodinkách, při prvním spuštění jejich aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hjertefrekvenstilladelse på uret gives separat på uret, første gang dets app kører."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Berechtigung für die Herzfrequenz auf der Uhr wird separat auf der Uhr erteilt, beim ersten Start der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El permiso de frecuencia cardíaca en el reloj se concede por separado, en el propio reloj, la primera vez que se ejecuta su aplicación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El permiso de frecuencia cardíaca en el reloj se concede por separado, en el reloj, la primera vez que se ejecuta su aplicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kellon sykelupa myönnetään erikseen kellon sovelluksen ensimmäisen käynnistyksen yhteydessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'autorisation de lecture de la fréquence cardiaque sur la montre est accordée séparément, sur la montre, lors de la première exécution de son application."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izin detak jantung di jam tangan diberikan secara terpisah, di jam tangan, saat aplikasi pertama kali dijalankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'autorizzazione per la frequenza cardiaca sull'Apple Watch viene concessa separatamente sull'orologio, la prima volta che la sua app viene eseguita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple Watchでの心拍数アクセス許可は、Watchのアプリが初めて実行された際にWatch上で個別に許可されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시계의 심박수 권한은 시계에서 앱이 처음 실행될 때 별도로 부여됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillatelse for hjertefrekvens på klokken gis separat, på klokken, første gang appen kjører."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De machtiging voor hartslag op het horloge wordt apart verleend, op het horloge, de eerste keer dat de app wordt gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uprawnienia do odczytu tętna na zegarku są przyznawane osobno, na zegarku, za pierwszym razem, gdy aplikacja się uruchamia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A permissão de frequência cardíaca no relógio é concedida separadamente, no próprio relógio, na primeira vez que seu aplicativo é executado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Доступ к данным о ЧСС на часах предоставляется отдельно при первом запуске приложения на часах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Behörighet för hjärtfrekvens på klockan beviljas separat på klockan första gången dess app körs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การอนุญาตอัตราการเต้นของหัวใจบนนาฬิกาจะได้รับการอนุมัติแยกต่างหากบนนาฬิกาในครั้งแรกที่แอปของนาฬิกาทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saatten kalp atış hızı izni, saatin uygulaması ilk çalıştığında saatten ayrı olarak verilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозвіл на доступ до серцевого ритму на годиннику надається окремо, на самому годиннику, при першому запуску його додатка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quyền truy cập nhịp tim trên đồng hồ được cấp riêng trên đồng hồ, vào lần đầu tiên ứng dụng của nó chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手表上的心率权限需首次运行其应用时在手表端单独授予。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手錶上的心率權限需在手錶上單獨授予，且僅在該應用程式首次執行時授予。"
          }
        }
      }
    },
