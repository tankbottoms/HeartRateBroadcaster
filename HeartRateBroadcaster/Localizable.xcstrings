    "Bluetooth access is denied, so this phone cannot advertise. Allow it in Settings › Privacy › Bluetooth.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم رفض الوصول إلى البلوتوث، لذا لا يمكن لهذا الهاتف الإعلان. اسمح بذلك في الإعدادات › الخصوصية › البلوتوث."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přístup k Bluetooth je odepřen, takže tento telefon nemůže vysílat. Povolte jej v Nastavení › Soukromí › Bluetooth."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth-adgang er nægtet, så denne telefon kan ikke udsende. Giv adgang i Indstillinger › Privatliv › Bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Bluetooth-Zugriff wurde verweigert, sodass dieses Telefon keine Werbung senden kann. Aktivieren Sie dies in den Einstellungen › Datenschutz › Bluetooth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El acceso a Bluetooth está denegado, por lo que este teléfono no puede transmitir. Permítelo en Ajustes › Privacidad › Bluetooth."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El acceso a Bluetooth está denegado, por lo que este teléfono no puede transmitir. Permítelo en Ajustes › Privacidad › Bluetooth."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth-käyttö on evätty, joten tämä puhelin ei voi mainostaa. Salli se asetuksista › Tietosuoja › Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accès Bluetooth est refusé, cet iPhone ne peut donc pas diffuser. Autorisez-le dans Réglages › Confidentialité › Bluetooth."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akses Bluetooth ditolak, sehingga ponsel ini tidak dapat melakukan iklan. Izinkan di Pengaturan › Privasi › Bluetooth."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'accesso Bluetooth è negato, quindi questo telefono non può effettuare pubblicità. Consenti l'accesso in Impostazioni > Privacy > Bluetooth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth のアクセスが拒否されたため、この iPhone はアドバタイズできません。[設定] › [プライバシー] › [Bluetooth] で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "블루투스 액세스가 거부되었으므로 이 전화기는 광고할 수 없습니다. 설정 › 개인정보 보호 › 블루투스에서 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilgang til Bluetooth er nektet, så denne telefonen kan ikke kringkaste. Aktiver det i Innstillinger › Personvern › Bluetooth."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth-toegang is geweigerd, dus deze telefoon kan geen advertenties uitzenden. Sta dit toe in Instellingen › Privacy › Bluetooth."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dostęp do Bluetooth jest zabroniony, więc ten telefon nie może nadawać. Zezwól na to w Ustawienia › Prywatność › Bluetooth."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O acesso ao Bluetooth foi negado, portanto este telefone não pode transmitir. Permita-o em Configurações › Privacidade › Bluetooth."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Доступ к Bluetooth запрещен, поэтому этот телефон не может передавать данные. Разрешите доступ в разделе «Настройки» > «Конфиденциальность» > «Bluetooth»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth-åtkomst nekas, så den här telefonen kan inte annonsera. Tillåt det i Inställningar › Integritet › Bluetooth."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเข้าถึงบลูทูธถูกปฏิเสธ ดังนั้นโทรศัพท์เครื่องนี้ไม่สามารถโฆษณาได้ โปรดอนุญาตในการตั้งค่า › ความปลอดภัย › บลูทูธ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth erişimi reddedildi, bu nedenle bu telefon reklam veremiyor. Ayarlar › Gizlilik › Bluetooth bölümünden izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Доступ до Bluetooth заборонено, тому цей телефон не може передавати дані. Дозвольте це в налаштуваннях: «Конфіденційність» > «Bluetooth»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Truy cập Bluetooth bị từ chối, nên điện thoại này không thể quảng bá. Hãy cho phép trong Cài đặt › Quyền riêng tư › Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "蓝牙访问被拒绝，因此此手机无法进行广播。请在“设置”>“隐私”>“蓝牙”中允许访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已拒絕藍牙存取權限，因此這支手機無法進行廣播。請前往「設定」>「隱私權」>「藍牙」中允許。"
          }
        }
      }
    },
    "Bluetooth gives a peripheral no way to read a central's name — the connection carries an identifier and a maximum packet size and nothing else. A head unit therefore appears here as a UUID assigned by this iPhone, stable for that device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمنح البلوتوث جهازًا طرفيًا أي طريقة لقراءة اسم الجهاز المركزي — تحمل الاتصال معرّفًا وأقصى حجم للحزمة ولا شيء آخر. لذلك يظهر وحدة الرأس هنا كـ UUID معين من قبل هذا الآيفون، ومستقر لذلك الجهاز."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth neposkytuje perifernímu zařízení žádný způsob, jak přečíst název centrálního zařízení — připojení nese pouze identifikátor a maximální velikost paketu a nic dalšího. Hlavice jednotky se proto zde zobrazí jako UUID přiřazené tímto iPhone, stabilní pro dané zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth giver en perifer enhed ingen mulighed for at læse en centrals navn — forbindelsen indeholder kun et identifikator og en maksimal pakkestørrelse og intet andet. En hovedenhed vises derfor her som en UUID tildelt af denne iPhone, som er stabil for den pågældende enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth gibt einem Peripheriegerät keine Möglichkeit, den Namen eines Centrals zu lesen – die Verbindung enthält nur eine Kennung und eine maximale Paketgröße, sonst nichts. Ein Head-Unit erscheint daher hier als UUID, die von diesem iPhone zugewiesen wurde und für dieses Gerät stabil ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth no ofrece a un periférico ninguna forma de leer el nombre de un central: la conexión lleva un identificador y un tamaño máximo de paquete y nada más. Por tanto, una unidad principal aparece aquí como un UUID asignado por este iPhone, estable para ese dispositivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth no ofrece a un periférico ninguna forma de leer el nombre de un dispositivo central: la conexión transmite un identificador y un tamaño máximo de paquete, y nada más. Por lo tanto, una unidad principal aparece aquí como un UUID asignado por este iPhone, estable para ese dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth ei anna perifeeriselle laitteelle tapaa lukea keskuksen nimeä – yhteys sisältää vain tunnisteen ja suurimman pakettikoon eikä muuta. Pääyksikkö näkyy tässä siis tälle iPhonelle määritettynä, laitteelle pysyvänä UUID-tunnisteena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le Bluetooth ne permet pas à un périphérique de lire le nom d’un central : la connexion transmet uniquement un identifiant et une taille maximale de paquet, rien d’autre. Une unité centrale apparaît donc ici sous la forme d’un UUID attribué par cet iPhone, stable pour cet appareil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth tidak memberi cara bagi periferal untuk membaca nama pusat — koneksi hanya membawa pengenal dan ukuran paket maksimum, dan tidak ada lagi. Oleh karena itu, unit kepala muncul di sini sebagai UUID yang ditetapkan oleh iPhone ini, stabil untuk perangkat tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth non offre alcun modo a un dispositivo periferico di leggere il nome di un dispositivo centrale: la connessione trasporta solo un identificatore, una dimensione massima del pacchetto e nient'altro. Un'unità principale appare quindi qui come un UUID assegnato da questo iPhone, stabile per quel dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth では、周辺機器がセントラルの名前を読み取る方法がありません。接続には識別子と最大パケットサイズのみが含まれ、それ以外は何もありません。そのため、ヘッドユニットは、この iPhone によって割り当てられ、そのデバイスに対して安定した UUID としてここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "블루투스는 주변 장치가 중앙 장치의 이름을 읽을 수 있는 방법을 제공하지 않습니다. 연결에는 식별자, 최대 패킷 크기 및 기타 정보가 포함됩니다. 따라서 헤드 유닛은 이 iPhone에서 해당 장치에 대해 안정적으로 할당된 UUID로 여기에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth gir en perifer enhet ingen måte å lese navnet til en sentralenhet på — tilkoblingen inneholder et identifikasjonsnummer og en maksimal pakkestørrelse og ingenting annet. En hodeenhet vises derfor her som en UUID tildelt av denne iPhone-en, stabil for den enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth biedt een peripheral geen manier om de naam van een central te lezen — de verbinding bevat een identificatiecode en een maximale pakketgrootte en verder niets. Een head unit verschijnt hier daarom als een UUID, toegewezen door deze iPhone, die stabiel is voor dat apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth nie daje urządzeniu peryferyjnemu możliwości odczytania nazwy urządzenia centralnego — połączenie przekazuje identyfikator i maksymalny rozmiar pakietu oraz nic więcej. Zestaw kierownicy pojawia się więc tutaj jako identyfikator UUID przypisany przez to iPhone'a, stabilny dla tego urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Bluetooth não oferece ao periférico nenhuma maneira de ler o nome do central: a conexão transmite um identificador e um tamanho máximo de pacote, e nada mais. Portanto, uma unidade de controle aparece aqui como um UUID atribuído por este iPhone, estável para esse dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth не позволяет периферийному устройству считывать имя центрального устройства — соединение передает только идентификатор и максимальный размер пакета. Поэтому головное устройство отображается здесь как UUID, назначенный этим iPhone и постоянный для этого устройства."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth ger en periferienhet ingen möjlighet att läsa en centrals namn — anslutningen innehåller ett identifieringsnummer och en maximal paketstorlek och inget annat. En huvudenhet visas därför här som en UUID som tilldelats av den här iPhone:n, stabil för den enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บลูทูธไม่อนุญาตให้อุปกรณ์เพอริเฟอรัลอ่านชื่อของเซ็นทรัล — การเชื่อมต่อจะส่งข้อมูลเฉพาะตัวระบุ ขนาดแพ็กเก็ตสูงสุด และไม่มีอื่นใดเพิ่มเติม ดังนั้นหน่วยหลักจึงปรากฏที่นี่เป็น UUID ที่กำหนดโดย iPhone เครื่องนี้ ซึ่งคงที่สำหรับอุปกรณ์นั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth, bir çevresel aygıtın merkezin adını okumasına olanak sağlamaz — bağlantı yalnızca bir tanımlayıcı ve maksimum paket boyutu taşır, başka hiçbir şey değil. Bu nedenle bir başlık ünitesi, bu iPhone tarafından o aygıt için atanmış ve sabit kalan bir UUID olarak burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth не дає периферійному пристрою можливості зчитати ім’я центрального пристрою — з’єднання передає лише ідентифікатор і максимальний розмір пакета, а нічого більше. Тому головний блок тут відображається як UUID, призначений цим iPhone й сталий для цього пристрою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth không cung cấp cách nào cho thiết bị ngoại vi đọc tên thiết bị trung tâm — kết nối chỉ mang theo một định danh và kích thước gói tối đa, không có gì khác. Do đó, đầu thu hiển thị ở đây dưới dạng UUID do iPhone này gán, ổn định cho thiết bị đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "蓝牙无法让外围设备读取中心设备的名称——连接仅携带标识符和最大数据包大小，无其他信息。因此，车机头显在此处显示为此 iPhone 分配的稳定 UUID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "藍牙無法讓週邊裝置讀取中央裝置的名稱——連線僅傳遞識別碼和最大封包大小，無其他資訊。因此，頭部單元在此處會顯示為由這支 iPhone 分配的 UUID，且對該裝置保持穩定。"
          }
        }
      }
    },
