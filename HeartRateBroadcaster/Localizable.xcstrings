          "stringUnit": {
            "state": "needs_review",
            "value": "ด้านเดียวเท่านั้น — คูณสอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca bir taraf — iki katı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Лише одна сторона — подвоєна"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ một bên — nhân đôi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅单侧 — 数值翻倍"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅單側 — 數值加倍"
          }
        }
      }
    },
    "Only %@ is live, so its reading is passed through unchanged — with nothing to cross-check against, averaging or smoothing would only add lag.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يوجد %@ فقط في الوضع المباشر، لذا يتم تمرير قراءته كما هي دون تغيير — وبدون أي شيء للمقارنة معه، فإن المتوسط أو التنعيم سيضيفان فقط تأخيرًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pouze %@ je aktivní, takže jeho naměřená hodnota je předávána beze změny — bez možnosti ověření by průměrování nebo vyhlazování pouze přidávalo zpoždění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun %@ er live, så dens måling videresendes uændret — uden noget at sammenligne med, ville gennemsnit og udjævning kun tilføje forsinkelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur %@ ist aktiv, daher wird dessen Messwert unverändert weitergegeben – ohne Vergleichswerte würden Mittelwertbildung oder Glättung nur eine Verzögerung verursachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo %@ está activo, por lo que su lectura se transmite sin cambios; sin nada con lo que comparar, promediar o suavizar solo añadiría retraso."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo %@ está activo, por lo que su lectura se transmite sin cambios; sin nada con qué comparar, promediar o suavizar solo añadiría retraso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vain %@ on aktiivinen, joten sen lukema välitetään muuttumattomana – ilman vertailukohtaa keskiarvon tai sileöinnin laskeminen aiheuttaisi vain viivettä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seul %@ est actif, donc sa valeur est transmise sans modification : sans référence pour la comparer, la moyenne ou le lissage n’ajouteraient que du retard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hanya %@ yang aktif, sehingga bacaannya diteruskan tanpa perubahan — tanpa pembanding, pengaveran atau penghalusan hanya akan menambah latensi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo %@ è attivo, quindi la sua lettura viene trasmessa invariata: senza nulla contro cui incrociare i dati, la media o la fluidificazione aggiungerebbero solo ritardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@のみがライブ状態のため、読み取り値は変更されずにそのまま渡されます。確認する対象がないため、平均化や平滑化は遅延を引き起こすだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”만 활성 상태이므로 판독값이 변경 없이 전달됩니다. 확인할 데이터가 없으므로 평균화나 평활화는 지연만 초래합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun %@ er aktiv, så avlesningen sendes gjennom uendret — uten noe å sammenligne med, vil gjennomsnitt eller utjevning bare føye til forsinkelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alleen %@ is actief, dus de meting wordt ongewijzigd doorgegeven — zonder iets om tegen te vergelijken, zouden gemiddelden of gladstrijken alleen vertraging toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tylko %@ jest aktywny, więc jego odczyt jest przekazywany bez zmian — bez możliwości weryfikacji, uśrednianie czy wygładzanie tylko by wprowadziło opóźnienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Somente %@ está ativo, portanto, sua leitura é transmitida sem alterações — sem nada para comparar, a média ou o suavizado apenas adicionariam atraso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В данный момент активен только %@, поэтому его показания передаются без изменений — без возможности перекрестной проверки усреднение или сглаживание лишь добавят задержку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Endast %@ är aktiv, så dess avläsning skickas vidare oförändrad — utan något att jämföra med skulle medelvärdesbildning eller utjämning bara lägga till fördröjning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "มีเพียง %@ เท่านั้นที่ใช้งานอยู่ ดังนั้นค่าที่อ่านได้จะถูกส่งผ่านโดยไม่เปลี่ยนแปลง — เมื่อไม่มีข้อมูลอื่นให้ตรวจสอบ การหาค่าเฉลี่ยหรือการทำให้เรียบจะยิ่งทำให้เกิดความล่าช้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yalnızca %@ canlı olduğundan, okuması değiştirilmeden aktarılır — karşılaştırılacak bir veri olmadığı için ortalama veya yumuşatma yalnızca gecikmeye neden olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Лише %@ є активним, тому його показник передається без змін — оскільки немає даних для порівняння, усереднення або згладжування лише додасть затримку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ có %@ đang hoạt động, nên giá trị đọc được truyền qua nguyên vẹn — không có gì để đối chiếu, việc lấy trung bình hoặc làm mượt chỉ thêm độ trễ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅%@处于活动状态，因此其读数原样传递——由于没有可交叉核对的数据，平均或平滑处理只会增加延迟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只有 %@ 處於即時狀態，因此其讀數會原樣傳遞——由於沒有其他數據可供交叉比對，平均或平滑處理只會增加延遲。"
          }
        }
      }
    },
