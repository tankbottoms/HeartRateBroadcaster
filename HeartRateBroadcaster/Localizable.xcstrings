    "Seat both AirPods in your ears — the sensor needs contact and a few beats before iOS publishes a reading.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ضع كلا سماعة AirPods في أذنيك — يحتاج المستشعر إلى تلامس وبضع نبضات قبل أن تنشر iOS قراءة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vložte obě sluchátka AirPods do uší — senzor potřebuje kontakt a několik tepů, než iOS zveřejní naměřenou hodnotu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sæt begge AirPods i dine ører — sensoren har brug for kontakt og et par hjerteslag, før iOS offentliggør en måling."
