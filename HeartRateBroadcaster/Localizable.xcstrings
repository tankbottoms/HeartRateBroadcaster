    "Still nothing after %llds. Tap the audio route button, pick iPhone, then pick your AirPods again — that re-establishes the sensor link.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يظهر شيء بعد %lld ثانية. اضغط على زر مسار الصوت، واختر iPhone، ثم اختر سماعات AirPods مرة أخرى — لإعادة إنشاء رابط المستشعر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Po %lld s stále nic. Klepněte na tlačítko pro výběr zvukové cesty, vyberte iPhone a poté znovu AirPods — tím se obnoví spojení se senzorem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der er stadig ingenting efter %llds. Tryk på lydspor-knappen, vælg iPhone, og vælg derefter dine AirPods igen – det genopretter sensorlinket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nach %llds immer noch nichts. Tippe auf die Audio-Routing-Schaltfläche, wähle iPhone und dann erneut deine AirPods – das stellt die Sensorverbindung wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Sigue sin aparecer nada después de %llds? Toca el botón de ruta de audio, selecciona iPhone y luego vuelve a seleccionar tus AirPods para restablecer el enlace con el sensor."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún no hay nada después de %llds. Toca el botón de ruta de audio, selecciona iPhone y luego vuelve a seleccionar tus AirPods; eso restablecerá el enlace con el sensor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ei silti mitään %lld sekunnin jälkeen. Napauta äänen reitityspainiketta, valitse iPhone ja valitse sitten AirPods uudelleen — tämä luo anturiliitoksen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toujours rien après %llds. Appuyez sur le bouton de sélection de la voie audio, choisissez iPhone, puis sélectionnez à nouveau vos AirPods : cela rétablit le lien avec le capteur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Masih belum ada apa pun setelah %llds. Ketuk tombol rute audio, pilih iPhone, lalu pilih AirPods Anda lagi — hal ini akan menegakkan kembali tautan sensor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun risultato dopo %llds. Tocca il pulsante del percorso audio, seleziona iPhone, quindi seleziona di nuovo le tue AirPods: questo ristabilisce il collegamento con il sensore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld秒経過しても何も表示されません。オーディオリルートボタンをタップし、iPhoneを選択してからAirPodsを再度選択してください。これでセンサーリンクが再接続されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld초 후에도 아무것도 표시되지 않습니다. 오디오 경로 버튼을 탭하고 iPhone을 선택한 다음 AirPods을 다시 선택하세요. 이렇게 하면 센서 링크가 다시 설정됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingenting ennå etter %llds. Trykk på knappen for lydutgang, velg iPhone, og velg deretter AirPods på nytt – dette gjenoppretter sensortilkoblingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nog steeds niets na %llds. Tik op de audioweergaveknop, kies iPhone en kies vervolgens je AirPods opnieuw — dit herstelt de sensorverbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Po %lld s nadal brak wyników. Dotknij przycisku trasy audio, wybierz iPhone’a, a następnie ponownie wybierz AirPods — to przywróci połączenie z czujnikiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda nada após %llds. Toque no botão de rota de áudio, selecione iPhone e depois selecione seus AirPods novamente — isso reestabelece a conexão com o sensor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ничего не появилось после %lld с. Нажмите кнопку маршрутизации аудио, выберите iPhone, затем снова выберите AirPods — это восстановит связь с датчиком."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inget resultat än efter %lld s. Tryck på knappen för ljudväg, välj iPhone och välj sedan dina AirPods igen – det återupprättar sensorkopplingen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่พบอะไรหลังจาก %lld วินาที ให้แตะปุ่มเปลี่ยนเส้นทางเสียง เลือก iPhone แล้วเลือก AirPods ของคุณอีกครั้ง — การดำเนินการนี้จะสร้างการเชื่อมต่อเซ็นเซอร์ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld saniye sonra bile hiçbir şey yok. Ses yönlendirme düğmesine dokunun, iPhone'u seçin ve ardından AirPods'unuzu tekrar seçin — bu, sensör bağlantısını yeniden kurar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Продовжує нічого не показувати після %lld с. Торкніться кнопки маршруту аудіо, виберіть iPhone, а потім знову виберіть свої AirPods — це відновить з’єднання з датчиком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vẫn chưa có gì sau %lld giây. Nhấn nút định tuyến âm thanh, chọn iPhone, rồi chọn lại AirPods của bạn — thao tác này sẽ thiết lập lại liên kết cảm biến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld 秒后仍无反应。点击音频路由按钮，选择 iPhone，然后重新选择您的 AirPods —— 这将重新建立传感器连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "經過 %lld 秒後仍無任何反應。請輕觸音訊路徑按鈕，選擇 iPhone，然後再次選擇您的 AirPods，這樣可以重新建立感應器連線。"
          }
        }
      }
    },
