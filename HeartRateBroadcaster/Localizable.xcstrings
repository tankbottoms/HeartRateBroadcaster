    "Open HeartRate Broadcaster on your watch and tap Start. No heart rate is sent until the workout session is running.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح تطبيق HeartRate Broadcaster على ساعتك واضغط على بدء. لا يتم إرسال معدل ضربات القلب حتى تكون جلسة التمرين قيد التشغيل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otevřete aplikaci HeartRate Broadcaster na svém hodinkách a klepněte na Start. Tepová frekvence se nepřenáší, dokud není spuštěno cvičení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn HeartRate Broadcaster på dit ur og tryk på Start. Der sendes ingen puls, før trænings-sessionen kører."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne HeartRate Broadcaster auf deiner Uhr und tippe auf Start. Es wird keine Herzfrequenz gesendet, solange die Trainingseinheit nicht läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre HeartRate Broadcaster en tu reloj y toca Iniciar. No se envía ninguna frecuencia cardíaca hasta que la sesión de entrenamiento esté en curso."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre HeartRate Broadcaster en tu reloj y toca Iniciar. No se envía frecuencia cardíaca hasta que la sesión de entrenamiento esté en curso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avaa HeartRate Broadcaster kelloltasi ja napauta Aloita. Syketietoja ei lähetetä, ennen kuin harjoitus on käynnissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez HeartRate Broadcaster sur votre montre et appuyez sur Démarrer. Aucune fréquence cardiaque n’est envoyée tant que la séance d’entraînement n’est pas en cours."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buka HeartRate Broadcaster di jam tangan Anda dan ketuk Mulai. Detak jantung tidak akan dikirimkan hingga sesi latihan sedang berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri HeartRate Broadcaster sull’orologio e tocca Avvia. Non viene inviata alcuna frequenza cardiaca finché la sessione di allenamento non è in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ウォッチで「HeartRate Broadcaster」を開き、「開始」をタップしてください。ワークアウトセッションが実行されていない限り、心拍は送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시계에서 HeartRate Broadcaster를 열고 시작을 탭하세요. 운동 세션이 실행되기까지 심박 데이터가 전송되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne HeartRate Broadcaster på klokken din og trykk på Start. Ingen pulssignal sendes før treningsøkten er i gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Open HeartRate Broadcaster op je horloge en tik op Start. Er wordt pas een hartslag verzonden wanneer de trainingssessie actief is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz aplikację HeartRate Broadcaster na zegarku i dotknij opcji Start. Tętno nie jest wysyłane, dopóki nie będzie trwać sesia treningowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra o HeartRate Broadcaster no seu relógio e toque em Iniciar. Nenhuma frequência cardíaca é enviada até que a sessão de treino esteja em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте приложение HeartRate Broadcaster на часах и нажмите «Начать». Данные о частоте сердечных сокращений начинают передаваться только во время тренировки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öppna HeartRate Broadcaster på klockan och tryck på Starta. Ingen pulssignal skickas förrän träningspasset är igång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด HeartRate Broadcaster บนนาฬิกาของคุณแล้วแตะเริ่ม ไม่มีอัตราการเต้นของหัวใจถูกส่งจนกว่าเซสชันการออกกำลังกายจะกำลังทำงานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saatinizde KalpAtışHızı Yayıncısını açın ve Başlat’a dokunun. Egzersiz oturumu çalışana kadar kalp atış hızı gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте програму HeartRate Broadcaster на годиннику й торкніться «Почати». Частота серцевих скорочень надсилатиметься лише під час тренування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở HeartRate Broadcaster trên đồng hồ của bạn và nhấn Bắt đầu. Không có nhịp tim nào được gửi cho đến khi phiên tập luyện đang chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在您的手表上打开 HeartRate Broadcaster 并点击“开始”。在锻炼会话运行之前，不会发送心率数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在您的手錶上開啟 HeartRate Broadcaster 並輕觸「開始」。在運動課程執行期間，才會傳送心率。"
          }
        }
      }
    },
