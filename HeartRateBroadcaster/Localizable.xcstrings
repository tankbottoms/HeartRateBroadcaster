    "Allow Heart Rate under Health › Sharing › Apps, then use the audio route button to reconnect your AirPods.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اسمح بالوصول إلى معدل ضربات القلب تحت الصحة › المشاركة › التطبيقات، ثم استخدم زر مسار الصوت لإعادة توصيل سماعات AirPods."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povolte Srdce pod Zdraví › Sdílení › Aplikace, poté použijte tlačítko audio trasy pro opětovné připojení AirPods."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillad Puls under Sundhed › Deling › Apps, og brug derefter lydspor-knappen til at genforbinde dine AirPods."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaube Herzfrequenz unter Gesundheit › Freigabe › Apps, und verwende dann die Audio-Raste-Taste, um deine AirPods erneut zu verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite Frecuencia cardíaca en Salud › Compartir › Aplicaciones, y luego usa el botón de ruta de audio para volver a conectar tus AirPods."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite Frecuencia cardíaca en Salud › Compartir › Aplicaciones, y luego usa el botón de ruta de audio para volver a conectar tus AirPods."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salli Syke osiossa Terveys › Jaottelu › Sovellukset, ja yhdistä AirPods uudelleen ääniratapainikkeella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez Fréquence cardiaque dans Santé › Partage › Applications, puis utilisez le bouton de route audio pour reconnecter vos AirPods."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izinkan Detak Jantung di Kesehatan › Berbagi › Aplikasi, lalu gunakan tombol rute audio untuk menyambungkan kembali AirPods Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consenti Frequenza cardiaca in Salute > Condivisione > App, quindi usa il pulsante del percorso audio per riconnettere le tue AirPods."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定 › Health › シェアリング › アプリで「心拍数」を許可し、オーディオルートボタンを使用してAirPodsを再接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "건강 › 공유 › 앱에서 심박수 허용을 활성화한 후 오디오 경로 버튼을 사용하여 AirPods을 다시 연결하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktiver Hjertefrekens under Helse › Deling › Apper, og bruk deretter lydspor-knappen for å koble AirPods på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sta Hartslag toe onder Gezondheid › Delen › Apps, en gebruik vervolgens de audio-route-knop om je AirPods opnieuw te verbinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zezwól na dostęp do Tętna w Zdrowie › Udostępnianie › Aplikacje, a następnie użyj przycisku trasy audio, aby ponownie połączyć AirPods."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permita o Acesso à Frequência Cardíaca em Saúde › Compartilhamento › Apps, e use o botão de rota de áudio para reconectar seus AirPods."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешите доступ к данным «Частота сердечных сокращений» в настройках: «Здоровье» > «Общий доступ» > «Приложения», затем используйте кнопку аудиоканала для повторного подключения AirPods."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillåt Puls under Hälsa › Delning › Appar, och använd sedan ljudvägsknappen för att ansluta dina AirPods igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตให้ใช้อัตราการเต้นของหัวใจภายใต้สุขภาพ › การแชร์ › แอป จากนั้นใช้ปุ่มเส้นทางเสียงเพื่อเชื่อมต่อ AirPods ของคุณอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sağlık › Paylaşım › Uygulamalar altında Kalp Atış Hızına izin verin, ardından AirPods’u yeniden bağlamak için ses yolu düğmesini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозвольте доступ до Частоти серцевих скорочень у Розділ Здоров’я › Спільний доступ › Додатки, а потім скористайтеся кнопкою аудіошляху, щоб повторно підключити AirPods."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép Nhịp tim dưới Sức khỏe › Chia sẻ › Ứng dụng, sau đó sử dụng nút tuyến âm thanh để kết nối lại AirPods của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在“健康”>“共享”>“App”中允许访问“心率”，然后使用音频路由按钮重新连接 AirPods。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請在「健康」>「共用」>「應用程式」中允許「心率」，然後使用音訊路徑按鈕重新連線您的 AirPods。"
          }
        }
      }
    },
    "Allowed": {
