          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strona internetowa jest dostępna w dwudziestu pięciu językach i dostosowuje się do przeglądarki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O site é publicado nos mesmos vinte e cinco idiomas e segue o idioma do seu navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Веб-сайт опубликован на двадцати пяти языках и следует настройкам вашего браузера."
          }
        },
        "sv": {
