    "iOS does not tell an app the name or identifier of the paired watch. Identity appears here once the watch app has connected at least once.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يخبر iOS التطبيق باسم أو معرّف الساعة المقترنة. يظهر الهوية هنا بمجرد أن يتصل تطبيق الساعة مرة واحدة على الأقل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS neoznámí aplikaci název ani identifikátor spárovaných hodinek. Identita se zobrazí, jakmile se aplikace pro Apple Watch alespoň jednou připojí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS fortæller ikke en app navnet eller identifikatoren for det parrede ur. Identitet vises her, når urknapprogrammet har oprettet forbindelse mindst én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS teilt einer App nicht den Namen oder die Kennung der gekoppelten Uhr mit. Die Identität wird hier angezeigt, sobald die Watch-App mindestens einmal verbunden war."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS no indica a una aplicación el nombre o el identificador del reloj emparejado. La identidad aparece aquí una vez que la app del reloj se ha conectado al menos una vez."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS no indica a una aplicación el nombre o el identificador del reloj emparejado. La identidad aparece aquí una vez que la app del reloj se ha conectado al menos una vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS ei kerro sovellukselle paritetun kellon nimeä tai tunnistetta. Tunnus näkyy tässä, kun Watch-sovellus on yhdistetty vähintään kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS ne communique pas à une application le nom ou l’identifiant de la montre appairée. L’identité apparaît ici une fois que l’application Watch s’est connectée au moins une fois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS tidak memberi tahu aplikasi nama atau pengidentifikasi jam tangan yang dipasangkan. Identitas muncul di sini setelah aplikasi jam tangan terhubung setidaknya sekali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS non fornisce all'app il nome o l'identificativo dell'orologio accoppiato. L'identità appare qui una volta che l'app dell'orologio si è connessa almeno una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS は、ペアリングされた Apple Watch の名前や識別子をアプリに通知しません。Watch アプリが少なくとも 1 回接続されると、ここで ID が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS는 앱에 페어링된 시계의 이름이나 식별자를 알려주지 않습니다. 시계 앱이 최소 한 번 연결된 후에야 신원이 여기에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS opplyser ikke en app om navnet eller identifikatoren til den sammenkoblede klokken. Identiteten vises her når klokkeappen har koblet seg til minst én gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS vertelt een app niet de naam of het identificatienummer van het gekoppelde horloge. Identiteit verschijnt hier zodra de watch-app minstens één keer verbinding heeft gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS nie udostępnia aplikacji nazwy ani identyfikatora sparowanego zegarka. Tożsamość pojawia się tutaj po pierwszym połączeniu aplikacji na zegarek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O iOS não informa ao aplicativo o nome ou o identificador do relógio emparelhado. A identidade aparece aqui assim que o app do relógio se conectar pelo menos uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS не сообщает приложению имя или идентификатор сопряженных часов. Эти данные отображаются здесь после того, как приложение для Watch хотя бы раз подключится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS meddelar inte en app namnet eller identifieraren för den ihopkopplade klockan. Identiteten visas här så snart klockappen har anslutit minst en gång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS ไม่แจ้งชื่อหรือรหัสระบุของนาฬิกาที่จับคู่กับแอป รหัสจะปรากฏที่นี่เมื่อแอปบนนาฬิกาได้เชื่อมต่อกันอย่างน้อยหนึ่งครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS, eşleştirilmiş saatin adını veya tanımlayıcısını uygulamaya bildirmez. Kimlik bilgileri, saat uygulaması en az bir kez bağlandıktan sonra burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS не повідомляє застосунок ім’я або ідентифікатор парного годинника. Ці дані з’являються тут лише після того, як застосунок для годинника підключиться хоча б один раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS không cung cấp cho ứng dụng tên hoặc định danh của đồng hồ đã ghép đôi. Danh tính xuất hiện ở đây sau khi ứng dụng Watch đã kết nối ít nhất một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS 不会告知应用配对手表的名称或标识符。一旦手表应用至少连接过一次，身份信息便会显示在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS 不會告知應用程式配對手錶的名稱或識別碼。一旦手錶 App 至少連線過一次，這裡就會顯示身分資訊。"
          }
        }
      }
    },
    "iOS does not tell an app the name or identifier of the paired watch. These values are reported by the watch app itself and appear once it has connected at least once.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يخبر iOS التطبيق باسم أو معرّف الساعة المقترنة. تُبلغ هذه القيم بواسطة تطبيق الساعة نفسه وتظهر بمجرد أن يتصل مرة واحدة على الأقل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS neoznámí aplikaci název ani identifikátor spárovaných hodinek. Tyto hodnoty jsou hlášeny samotnou aplikací pro Apple Watch a zobrazí se, jakmile se alespoň jednou připojí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS fortæller ikke en app navnet eller identifikatoren for det parrede ur. Disse værdier rapporteres af urknapprogrammet selv og vises, når det har oprettet forbindelse mindst én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS teilt einer App nicht den Namen oder die Kennung der gekoppelten Uhr mit. Diese Werte werden von der Watch-App selbst gemeldet und erscheinen, sobald sie mindestens einmal verbunden war."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS no indica a una aplicación el nombre o el identificador del reloj emparejado. Estos valores los informa la propia app del reloj y aparecen una vez que se ha conectado al menos una vez."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS no indica a una aplicación el nombre o el identificador del reloj emparejado. Estos valores los informa la propia app del reloj y aparecen una vez que esta se ha conectado al menos una vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS ei kerro sovellukselle paritetun kellon nimeä tai tunnistetta. Nämä arvot ilmoittaa itse Watch-sovellus, ja ne näkyvät, kun se on yhdistetty vähintään kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS ne communique pas à une application le nom ou l’identifiant de la montre appairée. Ces valeurs sont rapportées par l’application Watch elle-même et apparaissent une fois qu’elle s’est connectée au moins une fois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS tidak memberi tahu aplikasi nama atau pengidentifikasi jam tangan yang dipasangkan. Nilai-nilai ini dilaporkan oleh aplikasi jam tangan itu sendiri dan muncul setelah terhubung setidaknya sekali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS non fornisce all'app il nome o l'identificativo dell'orologio accoppiato. Questi valori sono riportati dall'app dell'orologio stesso e appaiono una volta che si è connessa almeno una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS は、ペアリングされた Apple Watch の名前や識別子をアプリに通知しません。これらの値は Watch アプリ自体によって報告され、少なくとも 1 回接続されると表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS는 앱에 페어링된 시계의 이름이나 식별자를 알려주지 않습니다. 이 값들은 시계 앱 자체에서 보고되며, 최소 한 번 연결된 후에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS opplyser ikke en app om navnet eller identifikatoren til den sammenkoblede klokken. Disse verdiene oppgis av klokkeappen selv og vises når den har koblet seg til minst én gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS vertelt een app niet de naam of het identificatienummer van het gekoppelde horloge. Deze waarden worden gerapporteerd door de watch-app zelf en verschijnen zodra deze minstens één keer verbinding heeft gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS nie udostępnia aplikacji nazwy ani identyfikatora sparowanego zegarka. Te wartości są zgłaszane przez aplikację na zegarek i pojawiają się po jego pierwszym połączeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O iOS não informa ao aplicativo o nome ou o identificador do relógio emparelhado. Esses valores são relatados pelo próprio app do relógio e aparecem assim que ele se conecta pelo menos uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS не сообщает приложению имя или идентификатор сопряженных часов. Эти значения сообщаются самим приложением для Watch и появляются после того, как оно хотя бы раз подключится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS meddelar inte en app namnet eller identifieraren för den ihopkopplade klockan. Dessa värden rapporteras av klockappen själv och visas så snart den har anslutit minst en gång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS ไม่แจ้งชื่อหรือรหัสระบุของนาฬิกาที่จับคู่กับแอป ค่าเหล่านี้รายงานโดยแอปบนนาฬิกาเองและจะปรากฏเมื่อแอปได้เชื่อมต่อกันอย่างน้อยหนึ่งครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS, eşleştirilmiş saatin adını veya tanımlayıcısını uygulamaya bildirmez. Bu değerler saat uygulaması tarafından bildirilir ve en az bir kez bağlandıktan sonra görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS не повідомляє застосунок ім’я або ідентифікатор парного годинника. Ці значення повідомляє сам застосунок для годинника і з’являються після його підключення хоча б один раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS không cung cấp cho ứng dụng tên hoặc định danh của đồng hồ đã ghép đôi. Các giá trị này được báo cáo bởi chính ứng dụng Watch và xuất hiện sau khi ứng dụng đã kết nối ít nhất một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS 不会告知应用配对手表的名称或标识符。这些值由手表应用本身报告，并在其至少连接过一次后显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS 不會告知應用程式配對手錶的名稱或識別碼。這些值由手錶 App 本身回報，並在它至少連線過一次後顯示。"
          }
        }
      }
    },
    "iOS hides this app's Bluetooth advertisement when the app is in the background, so non-Apple devices can only find it while the screen is on. Once connected, you can lock the phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تخفي iOS إعلان البلوتوث لهذا التطبيق عندما يكون في الخلفية، لذا لا يمكن للأجهزة غير التابعة لـ Apple اكتشافه إلا أثناء تشغيل الشاشة. بمجرد الاتصال، يمكنك قفل الهاتف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS skryje Bluetooth reklamu této aplikace, když je na pozadí, takže nezařízení Apple ji najdou pouze tehdy, když je obrazovka zapnutá. Po připojení můžete telefon zamknout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS skjuler denne apps Bluetooth-reklame, når appen er i baggrunden, så ikke-Apple-enheder kun kan finde den, mens skærmen er tændt. Når der er oprettet forbindelse, kan du låse telefonen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS blendet die Bluetooth-Werbung dieser App im Hintergrund aus, sodass Nicht-Apple-Geräte sie nur finden können, solange der Bildschirm aktiv ist. Nach der Verbindung kannst du das iPhone sperren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS oculta la publicidad Bluetooth de esta aplicación cuando está en segundo plano, por lo que los dispositivos no Apple solo pueden encontrarla mientras la pantalla está encendida. Una vez conectada, puedes bloquear el teléfono."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS oculta la publicidad Bluetooth de esta aplicación cuando está en segundo plano, por lo que los dispositivos no Apple solo pueden encontrarla mientras la pantalla está encendida. Una vez conectada, puedes bloquear el teléfono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS piilottaa tämän sovelluksen Bluetooth-mainoksen, kun sovellus on taustalla, joten muut kuin Applen laitteet voivat löytää sen vain näytön ollessa päällä. Yhdistämisen jälkeen voit lukita puhelimen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS masque la publicité Bluetooth de cette application lorsque celle-ci est en arrière-plan, de sorte que les appareils non Apple ne peuvent la détecter que lorsque l’écran est allumé. Une fois connecté, vous pouvez verrouiller le téléphone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS menyembunyikan iklan Bluetooth aplikasi ini saat aplikasi berada di latar belakang, sehingga perangkat non-Apple hanya dapat menemukannya saat layar menyala. Setelah terhubung, Anda dapat mengunci ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS nasconde la pubblicità Bluetooth di questa app quando è in background, quindi i dispositivi non Apple possono trovarla solo mentre lo schermo è acceso. Una volta connesso, puoi bloccare il telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS は、アプリがバックグラウンドにあるときにこのアプリの Bluetooth アドバタイズを非表示にするため、Apple 以外のデバイスは画面がオンの間のみ検出できます。接続後は、iPhone のロック画面を使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS는 앱이 백그라운드에 있을 때 이 앱의 Bluetooth 광고를 숨기므로, Apple이 아닌 기기는 화면이 켜져 있을 때만 이를 찾을 수 있습니다. 연결된 후에는 iPhone의 화면을 잠글 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS skjuler Bluetooth-reklamen til denne appen når den er i bakgrunnen, slik at ikke-Apple-enheter bare kan finne den mens skjermen er på. Når du har koblet deg til, kan du låse telefonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS verbergt de Bluetooth-advertentie van deze app wanneer deze op de achtergrond draait, zodat niet-Apple-apparaten deze alleen kunnen vinden terwijl het scherm aan staat. Eenmaal verbonden kun je de telefoon vergrendelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS ukrywa reklamę Bluetooth tej aplikacji, gdy działa w tle, więc urządzenia niebędące częścią ekosystemu Apple mogą ją znaleźć tylko przy włączonym ekranie. Po nawiązaniu połączenia możesz zablokować telefon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O iOS oculta a transmissão Bluetooth deste aplicativo quando ele está em segundo plano, então dispositivos não Apple só podem encontrá-lo enquanto a tela estiver ligada. Após a conexão, você pode bloquear o telefone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS скрывает Bluetooth-рекламу этого приложения, когда оно находится в фоновом режиме, поэтому не-устройства Apple могут обнаружить его только при включенном экране. После подключения телефон можно заблокировать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS döljer appens Bluetooth-annonsering när appen är i bakgrunden, så att icke-Apple-enheter bara kan hitta den medan skärmen är på. När du väl har anslutit kan du låsa telefonen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS ซ่อนการโฆษณา Bluetooth ของแอปนี้เมื่อแอปอยู่ในพื้นหลัง ดังนั้นอุปกรณ์ที่ไม่ใช่ของ Apple จะค้นหาแอปได้เฉพาะเมื่อหน้าจอเปิดอยู่เท่านั้น หลังจากเชื่อมต่อแล้ว คุณสามารถล็อกโทรศัพท์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS, uygulama arka plandayken bu uygulamanın Bluetooth reklamını gizler; bu nedenle Apple dışı cihazlar yalnızca ekran açıkken onu bulabilir. Bağlandıktan sonra telefonu kilitleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS приховує Bluetooth-рекламу цього застосунку, коли він працює у фоновому режимі, тому пристрої не від Apple можуть знайти його лише тоді, коли екран увімкнено. Після підключення ви можете заблокувати телефон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS ẩn quảng cáo Bluetooth của ứng dụng này khi ứng dụng ở chế độ nền, vì vậy các thiết bị không phải của Apple chỉ có thể tìm thấy nó khi màn hình đang bật. Sau khi kết nối, bạn có thể khóa điện thoại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当应用处于后台时，iOS 会隐藏该应用的蓝牙广播，因此非 Apple 设备仅在屏幕开启时才能找到它。连接后，您可以锁定手机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "當應用程式在背景執行時，iOS 會隱藏此應用程式的 Bluetooth 廣告，因此非 Apple 裝置僅能在螢幕開啟時找到它。連線後，您可以鎖定手機。"
          }
        }
      }
    },
    "iOS only shows a permission prompt the first time it is asked. After a denial, the toggles above are the only way to change the answer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يظهر iOS مربع حوار الإذن إلا في المرة الأولى التي يُطلب فيها. بعد الرفض، تكون المفاتيح أعلاه هي الطريقة الوحيدة لتغيير الإجابة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS zobrazí výzvu k povolení pouze při prvním požadavku. Po zamítnutí jsou přepínače výše jediným způsobem, jak odpověď změnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS viser kun en tilladelsesprompt første gang, den bliver bedt om det. Efter en afvisning er kontakterne ovenfor den eneste måde at ændre svaret på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS zeigt einen Berechtigungsdialog nur beim ersten Mal an. Nach einer Ablehnung sind die oben genannten Schalter die einzige Möglichkeit, die Einstellung zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS solo muestra un cuadro de permiso la primera vez que se solicita. Tras denegarlo, los interruptores anteriores son la única forma de cambiar la respuesta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS solo muestra un cuadro de diálogo de permiso la primera vez que se solicita. Tras denegarlo, los interruptores anteriores son la única forma de cambiar la respuesta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS näyttää käyttöoikeuskehotteen vain ensimmäisen kerran, kun sitä pyydetään. Kieltämisen jälkeen yllä olevat kytkimet ovat ainoa tapa muuttaa vastausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS n’affiche une invite d’autorisation que la première fois qu’elle est demandée. Après un refus, les commutateurs ci-dessus sont le seul moyen de modifier la réponse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS hanya menampilkan permintaan izin pertama kali diminta. Setelah ditolak, pengalih di atas adalah satu-satunya cara untuk mengubah jawaban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS mostra una richiesta di autorizzazione solo la prima volta che viene chiesta. Dopo un diniego, gli interruttori sopra sono l'unico modo per modificare la risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS は、権限プロンプトを最初に要求されたときのみ表示します。拒否した後、設定を変更できるのは上記のトグルのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS는 권한 요청을 처음 받을 때만 프롬프트를 표시합니다. 거절 후에는 위의 토글만 사용하여 설정을 변경할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS viser bare en tillatelsesforespørsel første gang den blir bedt om det. Etter en avslåing er bryterne ovenfor den eneste måten å endre svaret på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS toont een machtigingsdialoog alleen bij de eerste keer dat hierom wordt gevraagd. Na een weigering zijn de schakelaars hierboven de enige manier om het antwoord te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS wyświetla monit o uprawnienia tylko za pierwszym razem. Po odrzuceniu, jedynym sposobem na zmianę odpowiedzi są przełączniki powyżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O iOS mostra um prompt de permissão apenas na primeira vez que é solicitado. Após uma negação, as opções acima são a única maneira de alterar a resposta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS показывает запрос разрешения только в первый раз. После отказа изменить ответ можно только с помощью переключателей выше."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS visar bara en behörighetsfrågan första gången den ställs. Efter ett avslag är reglagen ovan det enda sättet att ändra svaret."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS จะแสดงคำขอสิทธิ์เฉพาะครั้งแรกเท่านั้น หลังจากปฏิเสธแล้ว สวิตช์ด้านบนเป็นวิธีเดียวในการเปลี่ยนคำตอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS, izin istemi yalnızca ilk istendiğinde gösterilir. Reddedildikten sonra, yanıtı değiştirmenin tek yolu yukarıdaki geçişlerdir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS показує запит на дозвіл лише вперше. Після відхилення єдиний спосіб змінити відповідь — використати перемикачі вище."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS chỉ hiển thị lời nhắc quyền lần đầu tiên nó được yêu cầu. Sau khi từ chối, các công tắc trên đây là cách duy nhất để thay đổi câu trả lời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS 仅在首次询问时显示权限提示。拒绝后，上方的开关是更改答案的唯一方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS 僅在首次詢問時顯示權限提示。拒絕後，上方的切換按鈕是唯一更改答案的方式。"
          }
        }
      }
    },
