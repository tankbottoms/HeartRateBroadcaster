    "Starts a Live Activity while broadcasting, so you can see the heart rate your head unit is receiving without unlocking the phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يبدأ نشاطًا مباشرًا أثناء البث، مما يتيح لك عرض معدل ضربات القلب الذي تستقبله وحدة الرأس دون الحاجة إلى إيقاظ الهاتف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spustí Live Activity během vysílání, abyste mohli sledovat tepovou frekvenci, kterou přijímá vaše hlavová jednotka, aniž byste museli odemykat telefon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starter en Live-aktivitet under udsendelse, så du kan se den hjertefrekvens, din hovedenhed modtager, uden at låse op for telefonen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Startet eine Live-Aktivität während der Übertragung, sodass du die Herzfrequenz, die dein Headset empfängt, sehen kannst, ohne das Telefon zu entsperren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicia una Actividad en directo durante la transmisión para que puedas ver la frecuencia cardíaca que recibe tu unidad de cabeza sin desbloquear el teléfono."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicia una Actividad en vivo durante la transmisión, para que puedas ver la frecuencia cardíaca que recibe tu unidad principal sin desbloquear el teléfono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aloittaa Live-toiminnon lähetyksen aikana, jolloin näet päätelaitteen vastaanottaman sykkeen ilman puhelimen lukituksen avaamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Démarre une activité en direct pendant la diffusion, afin que vous puissiez voir la fréquence cardiaque que votre unité de tête reçoit sans déverrouiller le téléphone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Memulai Live Activity saat pemancaran berlangsung, sehingga Anda dapat melihat detak jantung yang diterima unit kepala tanpa perlu membuka kunci ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avvia un'Attività in diretta durante la trasmissione, così puoi vedere la frequenza cardiaca che il tuo dispositivo riceve senza dover sbloccare il telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブロードキャスト中にライブアクティビティを開始し、電話をロック解除せずにヘッドユニットが受信している心拍数を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "방송 중 Live Activity를 시작하여 기기를 잠금 해제하지 않고도 헤드 유닛이 수신하는 심박수를 확인할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starter en Live-aktivitet mens sendingen pågår, slik at du kan se hjertefrekvensen hodestasjonen mottar uten å låse opp telefonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Startt een Live Activiteit tijdens het uitzenden, zodat je je hartslag kunt zien die je head unit ontvangt, zonder je telefoon te hoeven ontgrendelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchamia aktywność na żywo podczas nadawania, dzięki czemu możesz zobaczyć tętno odbierane przez głowicę bez odblokowywania telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicia uma Atividade ao Vivo durante a transmissão, para que você possa ver a frequência cardíaca que seu dispositivo de cabeça está recebendo sem desbloquear o telefone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запускает Live Activity во время трансляции, чтобы вы могли видеть частоту сердечных сокращений, получаемую головным блоком, не разблокируя телефон."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Startar en Live-aktivitet under sändningen, så att du kan se vilken hjärtfrekvens din huvudenhet tar emot utan att låsa upp telefonen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เริ่มกิจกรรมสด (Live Activity) ขณะส่งสัญญาณ เพื่อให้คุณสามารถดูอัตราการเต้นของหัวใจที่อุปกรณ์ส่วนหัวของคุณได้รับได้โดยไม่ต้องปลดล็อกโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yayın sırasında bir Live Activity başlatır, böylece telefonu kilidini açmadan başlık ünitesinin aldığı kalp atış hızını görebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запускає Live Activity під час мовлення, щоб ви бачили частоту серцевих скорочень, яку отримує ваш головний блок, не розблоковуючи телефон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bắt đầu Hoạt động Trực tiếp trong khi phát, để bạn có thể xem nhịp tim mà đơn vị đầu của bạn đang nhận mà không cần mở khóa điện thoại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "广播时启动实时活动，以便您无需解锁手机即可查看车把终端接收到的心率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開始廣播時啟動 Live Activity，讓您在不需要解鎖手機的情況下，查看頭部裝置接收到的心率。"
          }
        }
      }
    },
