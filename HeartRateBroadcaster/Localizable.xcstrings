    "Fused mode is selected but neither the watch nor AirPods have reported inside the last %llds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم تحديد الوضع المدمج ولكن لا الساعة ولا سماعات AirPods قد أبلغت خلال آخر %lld ثانية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Režim Fused je vybrán, ale ani hodinky, ani AirPods neodeslaly data během posledních %lld s."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fusioneret tilstand er valgt, men hverken uret eller AirPods har rapporteret inden for de sidste %lld sek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Fused-Modus ist ausgewählt, aber weder die Uhr noch die AirPods haben in den letzten %lld Sekunden Daten gemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El modo fusionado está seleccionado, pero ni el reloj ni los AirPods han informado en los últimos %lld s."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El modo fusionado está seleccionado, pero ni el reloj ni los AirPods han informado en los últimos %lld s."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhdistetty tila on valittu, mutta kello tai AirPods eivät ole raportoineet viimeisen %lld sekunnin aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le mode Fused est sélectionné, mais ni la montre ni les AirPods n'ont envoyé de données au cours des %lld dernières secondes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mode Fused dipilih, tetapi jam tangan maupun AirPods belum melaporkan data dalam %lld detik terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La modalità Fused è selezionata, ma né l'Apple Watch né gli AirPods hanno inviato dati negli ultimi %lld secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "融合モードが選択されていますが、直近%lld秒以内にApple WatchまたはAirPodsからデータが報告されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "퓨즈드 모드가 선택되었지만 시계나 AirPods에서 최근 %lld초 이내에 데이터가 보고되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fusjonsmodus er valgt, men verken klokken eller AirPods har rapportert de siste %lld sekundene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gefuseerde modus is geselecteerd, maar noch het horloge noch de AirPods hebben binnen de laatste %llds gerapporteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybrano tryb połączony, ale ani zegarek, ani AirPods nie zgłosiły danych w ciągu ostatnich %lld s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O modo Fused está selecionado, mas nem o relógio nem os AirPods relataram dados nos últimos %llds."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
