    "Lock the watch screen against accidental taps": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قفل شاشة الساعة ضد اللمسات العرضية"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zamkněte obrazovku hodinek proti nechtěným dotykům"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lås ur-skærmen mod utilsigtede tryk"
          }
        },
        "de": {
