    "Within %lld BPM, so both are trusted and %@ is being sent as their average — which also halves the sample noise of either one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ضمن %1$lld نبضة في الدقيقة، لذا يُعتمد على كليهما ويتم إرسال %2$@ كمتوسط لهما — مما يقلل أيضًا من ضوضاء العينة لكليهما إلى النصف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "V rozmezí %1$lld tepů za minutu, takže jsou oba spolehlivé a %2$@ je odesíláno jako jejich průměr – což také snižuje šum vzorkování každého z nich o polovinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inden for %1$lld BPM, så begge er betroet, og %2$@ sendes som deres gennemsnit — hvilket også halverer støjprøven fra den ene eller anden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Innerhalb von %1$lld BPM, daher werden beide als vertrauenswürdig eingestuft und %2$@ wird als ihr Durchschnitt gesendet – was auch das Stichprobenrauschen von beiden halbiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Within %1$lld BPM, so both are trusted and %2$@ is being sent as their average — which also halves the sample noise of either one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dentro de %1$lld BPM, por lo que ambos son confiables y %2$@ se envía como su promedio, lo que también reduce a la mitad el ruido de muestreo de cualquiera de ellos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dentro de %1$lld BPM, por lo que ambos son confiables y %2$@ se envía como su promedio, lo que también reduce a la mitad el ruido de muestreo de cualquiera de ellos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arvon sisällä %1$lld bpm molemmat ovat luotettavia ja %2$@ lähetetään niiden keskiarvona — mikä puolittaa kummankin näytteen kohinan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dans une marge de %1$lld BPM, les deux sont donc fiables et %2$@ est envoyé en tant que leur moyenne, ce qui réduit également de moitié le bruit d’échantillonnage de l’un ou l’autre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dalam %1$lld BPM, sehingga keduanya dipercaya dan %2$@ dikirim sebagai rata-ratanya — yang juga mengurangi noise sampel masing-masing sebesar setengahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entro %1$lld BPM, quindi entrambi sono considerati attendibili e %2$@ viene inviato come loro media, il che dimezza anche il rumore di campionamento di ciascuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld BPM 以内のため、両方が信頼され、その平均値である %2$@ が送信されています。これにより、それぞれのサンプリングノイズが半分になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld BPM 이내이므로 두 값 모두 신뢰할 수 있으며, %2$@가 그들의 평균으로 전송됩니다. 이는 각 값의 샘플 노이즈를 절반으로 줄여줍니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Innefor %1$lld BPM, så begge er tillitverdige og %2$@ sendes som gjennomsnittet — som også halverer støyprøvene fra hver av dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Binnen %1$lld BPM, dus beide worden vertrouwd en %2$@ wordt als hun gemiddelde verzonden — wat ook het steekproefruis van elk van hen halveert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "W granicach %1$lld BPM, więc oba są wiarygodne, a %2$@ jest wysyłane jako ich średnia — co również zmniejsza szum próbkowania każdego z nich o połowę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dentro de %1$lld BPM, então ambos são confiáveis e %2$@ está sendo enviado como a média deles — o que também reduz pela metade o ruído de amostragem de cada um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В пределах %1$lld уд/мин, поэтому оба значения считаются достоверными, и %2$@ отправляется как их среднее арифметическое — это также вдвое снижает шум выборки каждого из них."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inom %1$lld BPM, så båda är betrodda och %2$@ skickas som deras medelvärde — vilket också halverar stickprovsbruset för var och en."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อยู่ในช่วง %1$lld BPM ดังนั้นทั้งสองตัวจึงได้รับความน่าเชื่อถือ และ %2$@ กำลังถูกส่งเป็นค่าเฉลี่ยของทั้งสอง — ซึ่งช่วยลดสัญญาณรบกวนของตัวอย่างจากแต่ละตัวลงครึ่งหนึ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld BPM içinde, bu nedenle her ikisi de güvenilir kabul edilir ve ortalamaları olarak %2$@ gönderilir — bu, her birinin örnek gürültüsünü de yarıya indirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У межах %1$lld уд/хв, тому обидва датчики надійні, і %2$@ надсилається як їхнє середнє значення — це також зменшує шум вибірки кожного з них удвічі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trong vòng %1$lld BPM, vì vậy cả hai đều được tin cậy và %2$@ đang được gửi dưới dạng giá trị trung bình của chúng — điều này cũng làm giảm một nửa nhiễu mẫu của bất kỳ cảm biến nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 %1$lld BPM 范围内，因此两者均受信任，%2$@ 正作为其平均值发送——这也使任一传感器的采样噪声减半。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 %1$lld BPM 範圍內，因此兩者皆受信任，%2$@ 會作為它們的平均值傳送——這也能將任一者的採樣雜訊減半。"
          }
        }
      }
    },
