          "stringUnit": {
            "state": "needs_review",
            "value": "Aseta molemmat AirPodsit korviisi — anturin täytyy olla kosketuksissa ja ottaa muutama syke ennen kuin iOS julkaisee lukeman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Placez les deux AirPods dans vos oreilles : le capteur a besoin d’un contact et de quelques battements avant qu’iOS ne publie une mesure."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pasang kedua AirPods di telinga Anda — sensor memerlukan kontak dan beberapa detak sebelum iOS menerbitkan pembacaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inserisci entrambi gli AirPods nelle orecchie: il sensore richiede contatto e alcuni battiti prima che iOS pubblichi una lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirPodsを両耳に装着してください — センサーは接触と、iOSが読み取り値を公開する前に数回の拍動が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AirPods를 귀에 모두 착용하세요 — 센서는 접촉과 iOS가 판독값을 게시하기 위해 몇 번의 심박이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plasser begge AirPods i ørene – sensoren trenger kontakt og noen slag før iOS publiserer en lesning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plaats beide AirPods in je oren — de sensor heeft contact en een paar hartslagen nodig voordat iOS een meting publiceert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Umieść obie słuchawki AirPods w uszach — czujnik wymaga kontaktu ze skórą i kilku uderzeń serca, zanim system iOS opublikuje odczyt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coloque ambos os AirPods em seus ouvidos — o sensor precisa de contato e de algumas batidas antes que o iOS publique uma leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поместите оба наушника AirPods в уши — датчику необходим контакт и несколько ударов сердца, прежде чем iOS опубликует показания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Placera båda AirPods i öronen – sensorn behöver kontakt och några slag innan iOS publicerar en avläsning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใส่ AirPods ทั้งสองข้างในหูของคุณ — เซนเซอร์ต้องสัมผัสกับหูและรอจังหวะเต้นของหัวใจสักสองสามจังหวะก่อนที่ iOS จะเผยแพร่ค่าที่อ่านได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her iki AirPods'u da kulaklarınıza takın — sensörün bir okuma yayınlaması için temas ve birkaç kalp atışına ihtiyacı vardır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вставте обидва AirPods у вухи — датчику потрібен контакт і кілька ударів серця, перш ніж iOS опублікує показання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đặt cả hai AirPods vào tai — cảm biến cần tiếp xúc và vài nhịp đập trước khi iOS xuất kết quả đo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将两只 AirPods 戴入耳中——传感器需要接触皮肤并等待几次心跳，iOS 才会发布读数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將兩隻 AirPods 都戴在耳朵裡——感測器需要接觸皮膚並等待幾個心跳，iOS 才會發布讀數。"
          }
        }
      }
    },
