        }
      }
    },
    "Locks the watch app's controls while it is streaming. Press and hold the screen for one second to unlock — a stray sleeve cannot stop the workout.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يقفل عناصر تحكم تطبيق الساعة أثناء البث. اضغط مع الاستمرار على الشاشة لمدة ثانية واحدة لفتح القفل — لن يمنع كمّ القميص المتسبب في توقف التمرين."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uzamkne ovládací prvky aplikace na hodinkách během streamování. Podržte obrazovku jednu sekundu pro odemknutí — rukáv nemůže zastavit trénink."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Låser ur-appens kontroller, mens den streamer. Tryk og hold på skærmen i ét sekund for at oplåse — en ærme kan ikke stoppe træningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sperren Sie die Steuerelemente der Uhren-App während des Streamings. Drücken und halten Sie den Bildschirm eine Sekunde lang, um ihn zu entsperren – ein Ärmel kann das Training nicht unterbrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloquea los controles de la aplicación del reloj mientras transmite. Mantén pulsada la pantalla durante un segundo para desbloquearla: una manga no puede interrumpir el entrenamiento."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloquea los controles de la aplicación del reloj mientras transmite. Mantén presionada la pantalla durante un segundo para desbloquearla: una manga no puede detener el entrenamiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lukitsee kellonsovelluksen ohjaimet, kun se lähettää dataa. Paina näyttöä ja pidä sitä painettuna sekunnin ajan avataksesi lukituksen — hihna ei keskeytä harjoitusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verrouille les contrôles de l’application de la montre pendant la diffusion. Appuyez longuement sur l’écran pendant une seconde pour le déverrouiller — une manche ne peut pas interrompre l’entraînement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mengunci kontrol aplikasi jam tangan saat sedang melakukan streaming. Tekan dan tahan layar selama satu detik untuk membuka kunci — lengan baju yang tidak sengaja tidak akan menghentikan latihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blocca i controlli dell'app dell'orologio durante lo streaming. Tieni premuto lo schermo per un secondo per sbloccare: una manica non può interrompere l'allenamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ストリーミング中はウォッチアプリの操作をロックします。画面を1秒間長押しするとロック解除されます。袖が擦れてもワークアウトが中断されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "스트리밍 중 시계 앱의 컨트롤을 잠급니다. 잠금을 해제하려면 화면을 1초간 길게 누르세요. 소매가 실수로 닿아도 운동이 중단되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Låser kontrollene i klokkeappen mens den strøms. Trykk og hold skjermen i ett sekund for å låse opp — en tilfeldig erme kan ikke stoppe treningen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vergrendelt de bediening van de horloge-app tijdens het streamen. Houd het scherm een seconde ingedrukt om te ontgrendelen — een losse mouw kan de training niet stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Blokuje elementy sterujące aplikacji zegarka podczas strumieniowania. Naciśnij i przytrzymaj ekran przez jedną sekundę, aby go odblokować — przypadkowe rękaw nie zatrzyma treningu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloqueia os controles do app do relógio enquanto ele está transmitindo. Pressione e segure a tela por um segundo para desbloquear — uma manga não pode interromper o treino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Блокирует элементы управления приложением на часах во время потоковой передачи. Нажмите и удерживайте экран в течение одной секунды, чтобы разблокировать — рукав не помешает тренировке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Låser klockappens kontroller medan den strömmar. Tryck och håll in skärmen i en sekund för att låsa upp – en vilseledande ärm kan inte stoppa passet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ล็อกการควบคุมของแอปบนนาฬิกาขณะสตรีม กดค้างที่หน้าจอหนึ่งวินาทีเพื่อปลดล็อก — แขนเสื้อที่เกะระจะไม่หยุดการออกกำลังกาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yayın yaparken saat uygulamasının kontrollerini kilitler. Kilidi açmak için ekrana bir saniye basılı tutun — rastgele bir manşet antrenmanı durdurmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Блокує керування додатком годинника під час потокової передачі. Натисніть і утримуйте екран протягом однієї секунди, щоб розблокувати — рукав не завадить тренуванню."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khóa các điều khiển của ứng dụng đồng hồ trong khi đang phát trực tiếp. Nhấn và giữ màn hình trong một giây để mở khóa — tay áo không thể làm gián đoạn buổi tập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在手表传输数据时锁定其控制功能。长按屏幕一秒钟即可解锁——衣袖不会意外中断锻炼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在手錶串流傳輸期間鎖定手錶應用程式的控制功能。按住螢幕一秒即可解鎖——衣袖不會意外中斷運動。"
          }
        }
      }
    },
