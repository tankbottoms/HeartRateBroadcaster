    "Bluetooth is off, so nothing is being advertised. Turn it on in Control Center.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "البلوتوث مغلق، لذا لا يتم الإعلان عن أي شيء. شغّله من مركز التحكم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth je vypnuté, takže se nic nevysílá. Zapněte jej na Ovládacím centru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth er slukket, så der udsendes intet. Tænd for det i Kontrolcenter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth ist ausgeschaltet, daher wird nichts gesendet. Schalten Sie es im Kontrollzentrum ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth está desactivado, por lo que no se está transmitiendo nada. Actívalo en el Centro de control."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth está desactivado, por lo que no se está transmitiendo nada. Actívalo en el Centro de control."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth on pois päältä, joten mitään ei mainosteta. Ota se käyttöön Pika-asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le Bluetooth est désactivé, aucune diffusion n’est donc en cours. Activez-le dans le Centre de contrôle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth mati, sehingga tidak ada yang diiklankan. Nyalakan di Pusat Kontrol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth disattivato, quindi non viene effettuata alcuna pubblicità. Attivalo nel Centro di controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth がオフのため、アドバタイズされていません。コントロールセンターでオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "블루투스가 꺼져 있으므로 광고되는 것이 없습니다. 제어 센터에서 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth er av, så ingenting blir kringkastet. Skru det på i Kontrollsentrum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth is uitgeschakeld, dus er worden geen advertenties uitgezonden. Schakel het in via het Bedieningscentrum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth jest wyłączony, więc nic nie jest nadawane. Włącz go w Centrum sterowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Bluetooth está desativado, portanto nada está sendo transmitido. Ative-o no Centro de Controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth выключен, поэтому данные не передаются. Включите его в Центре управления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth är avstängt, så inget annonseras. Aktivera det i Kontrollcentrum."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บลูทูธปิดอยู่ จึงไม่มีการโฆษณาใดๆ โปรดเปิดในศูนย์ควบคุม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth kapalı olduğundan hiçbir şey reklam verilmiyor. Kontrol Merkezi'nden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth вимкнено, тому нічого не передається. Увімкніть його в Центрі керування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth đang tắt, nên không có gì đang được quảng bá. Hãy bật nó trong Trung tâm Kiểm soát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "蓝牙已关闭，因此未进行任何广播。请在控制中心将其打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "藍牙已關閉，因此沒有任何廣播。請前往控制中心開啟。"
          }
        }
      }
    },
    "Bluetooth is off. Turn it on to find sensors.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البلوتوث مُطفأ. شغّله للعثور على المستشعرات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth je vypnuté. Zapněte ho, aby šly najít snímače."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth er slået fra. Slå det til for at finde sensorer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ist aus. Schalte es ein, um Sensoren zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Bluetooth está desactivado. Actívalo para encontrar sensores."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El Bluetooth está desactivado. Actívalo para encontrar sensores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth on pois päältä. Ota se käyttöön anturien löytämiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bluetooth est désactivé. Activez-le pour trouver des capteurs."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth mati. Aktifkan untuk menemukan sensor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Bluetooth è disattivato. Attivalo per trovare i sensori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothがオフです。オンにするとセンサーを検索できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth가 꺼져 있습니다. 켜면 센서를 찾을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth er av. Slå det på for å finne sensorer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth staat uit. Zet het aan om sensoren te vinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth jest wyłączony. Włącz go, aby znaleźć czujniki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bluetooth está desativado. Ative-o para encontrar sensores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth выключен. Включите его, чтобы найти датчики."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth är av. Slå på det för att hitta sensorer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ปิดอยู่ เปิดเพื่อค้นหาเซ็นเซอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth kapalı. Sensörleri bulmak için açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth вимкнено. Увімкніть його, щоб знайти датчики."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth đang tắt. Hãy bật để tìm cảm biến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙已关闭。开启后即可搜索传感器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙已關閉。開啟後即可搜尋感應器。"
          }
        }
      }
    },
