    "Mark whichever source is reading the most watts": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حدد مصدر الطاقة الذي يقرأ أعلى قيمة واط"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Označte zdroj, který zaznamenává nejvyšší výkon ve wattech"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markér den kilde, der måler flest watt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markiere die Quelle, die die meisten Watt misst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marca la fuente que esté midiendo más vatios"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marca la fuente que esté leyendo más vatios"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merkitse lähde, joka mittaa eniten tehoa"
          }
        },
        "fr": {
          "stringUnit": {
