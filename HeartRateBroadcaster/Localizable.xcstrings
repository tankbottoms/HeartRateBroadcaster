          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İzin Verildi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволено"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Được phép"
          }
        },
        "zh-Hans": {
