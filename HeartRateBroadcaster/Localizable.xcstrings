    "Connected to ^[%lld device](inflect: true), but there is no heart rate to send yet. Start the watch app, or switch Heart Rate Source to Test.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "متصل بـ ^[%lld جهاز](inflect: true)، لكن لا يوجد معدل ضربات قلب للإرسال بعد. شغّل تطبيق الساعة، أو غيّر مصدر معدل ضربات القلب إلى اختبار."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Připojeno k ^[%lld zařízení](inflect: true), ale zatím není k odeslání žádná tepová frekvence. Spusťte aplikaci na hodinkách nebo přepněte Zdroj tepové frekvence na Test."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbundet til ^[%lld enhed](inflect: true), men der er endnu ingen puls at sende. Start uret, eller skift pulskilde til Test."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbunden mit ^[%lld Gerät](inflect: true), aber es liegt noch kein Herzfrequenzwert zum Senden vor. Starte die Watch-App, oder wechsle die Herzfrequenzquelle auf Test."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectado a ^[%lld dispositivo](inflect: true), pero aún no hay frecuencia cardíaca para enviar. Inicia la app del reloj o cambia la fuente de frecuencia cardíaca a Prueba."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectado a ^[%lld dispositivo](inflect: true), pero aún no hay frecuencia cardíaca para enviar. Inicia la aplicación del reloj o cambia la Fuente de frecuencia cardíaca a Prueba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhdistetty ^[%lld laitteeseen](inflect: true), mutta sykkeen lähettämistä ei ole vielä aloitettu. Avaa kellosovellus tai vaihda sykelähteeksi Testi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connecté à ^[%lld appareil](inflect: true), mais aucune fréquence cardiaque n’est encore disponible pour l’envoi. Ouvrez l’application de la montre ou définissez la Source de fréquence cardiaque sur Test."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terkoneksi ke ^[%lld perangkat](inflect: true), tetapi belum ada detak jantung yang dapat dikirim. Mulai aplikasi jam tangan, atau ubah Sumber Detak Jantung ke Uji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connesso a ^[%lld dispositivo](inflect: true), ma non c'è ancora un battito da inviare. Avvia l'app dell'orologio o imposta la Fonte del battito su Test."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "^[%lld 台のデバイス](inflect: true) に接続済みですが、送信する心拍数データがありません。ウォッチアプリを起動するか、心拍数のソースをテストに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "^[%lld개 장치](inflect: true)에 연결되었지만 아직 전송할 심박수가 없습니다. 시계 앱을 시작하거나 심박수 소스를 테스트로 전환하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilkoblet ^[%lld enhet](inflect: true), men det er ingen hjertefrekvens å sende ennå. Start klokkeappen, eller bytt hjertefrekvenskilde til Test."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbonden met ^[%lld apparaat](inflect: true), maar er is nog geen hartslag om te verzenden. Start de horloge-app of schakel de hartslagbron in op Test."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połączono z ^[%lld urządzeniem](inflect: true), ale nie ma jeszcze danych tętna. Uruchom aplikację na zegarku lub zmień Źródło tętna na Testowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectado a ^[%lld dispositivo](inflect: true), mas ainda não há frequência cardíaca para enviar. Inicie o aplicativo do relógio ou altere a Fonte de Frequência Cardíaca para Teste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключено к ^[%lld устройству](inflect: true), но отправлять частоту сердечных сокращений пока нечего. Запустите приложение на часах или переключите источник частоты сердечных сокращений на «Тест»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ansluten till ^[%lld enhet](inflect: true), men det finns inget hjärtslagsvärde att skicka ännu. Starta klockappen eller växla hjärtslagskälla till Test."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เชื่อมต่ออยู่กับ ^[%lld อุปกรณ์](inflect: true) แต่ยังไม่มีอัตราการเต้นของหัวใจให้ส่ง เริ่มแอปบนนาฬิกา หรือเปลี่ยนแหล่งอัตราการเต้นของหัวใจเป็นการทดสอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "^[%lld aygıta](inflect: true) bağlandı, ancak gönderilecek bir kalp atış hızı henüz yok. Saat uygulamasını başlatın veya Kalp Atış Hızı Kaynağını Test olarak değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підключено до ^[%lld пристрою](inflect: true), але надсилати пульс ще неможливо. Запустіть додаток для годинника або змініть джерело пульсу на «Тест»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã kết nối với ^[%lld thiết bị](inflect: true), nhưng chưa có nhịp tim để gửi. Hãy mở ứng dụng đồng hồ hoặc chuyển Nguồn Nhịp tim sang Thử nghiệm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已连接 ^[%lld 台设备](inflect: true)，但尚未有心率数据可发送。请启动手表应用，或将心率来源切换为测试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已連線至 ^[%lld 個裝置](inflect: true)，但還沒有心率資料可傳送。請啟動手錶應用程式，或將心率來源設為測試。"
          }
        }
      }
    },
    "Connected to ^[%lld device](inflect: true), but there is no heart rate to send, so no frames are going out. Start the watch app, put in AirPods Pro 3, or set the source to Test.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "متصل بـ ^[%lld جهاز](inflect: true)، لكن لا يوجد معدل ضربات قلب للإرسال، لذا لا يتم إرسال أي إطارات. شغّل تطبيق الساعة، أو ضع سماعات AirPods Pro 3، أو اضبط المصدر على اختبار."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Připojeno k ^[%lld zařízení](inflect: true), ale není k odeslání žádná tepová frekvence, takže se nepřenášejí žádné snímky. Spusťte aplikaci na hodinkách, vložte AirPods Pro 3 nebo nastavte zdroj na Test."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbundet til ^[%lld enhed](inflect: true), men der er ingen puls at sende, så der sendes ingen rammer. Start uret, indsæt AirPods Pro 3, eller indstil kilden til Test."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbunden mit ^[%lld Gerät](inflect: true), aber es liegt kein Herzfrequenzwert zum Senden vor, daher werden keine Frames ausgegeben. Starte die Watch-App, lege AirPods Pro 3 ein, oder stelle die Quelle auf Test."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectado a ^[%lld dispositivo](inflect: true), pero no hay frecuencia cardíaca para enviar, por lo que no se envían tramas. Inicia la app del reloj, introduce AirPods Pro 3 o establece la fuente en Prueba."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectado a ^[%lld dispositivo](inflect: true), pero no hay frecuencia cardíaca para enviar, por lo que no se envían tramas. Inicia la aplicación del reloj, coloca los AirPods Pro 3 o establece la fuente en Prueba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhdistetty ^[%lld laitteeseen](inflect: true), mutta sykkeen lähettämistä ei ole aloitettu, joten kehyksiä ei lähetetä. Avaa kellosovellus, aseta AirPods Pro 3 -kuulokkeet korvaan tai aseta lähteeksi Testi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connecté à ^[%lld appareil](inflect: true), mais aucune fréquence cardiaque n’est disponible pour l’envoi, donc aucun trame n’est émise. Ouvrez l’application de la montre, insérez des AirPods Pro 3 ou définissez la source sur Test."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terkoneksi ke ^[%lld perangkat](inflect: true), tetapi tidak ada detak jantung yang dapat dikirim, sehingga tidak ada frame yang dikirim. Mulai aplikasi jam tangan, pasang AirPods Pro 3, atau atur sumber ke Uji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connesso a ^[%lld dispositivo](inflect: true), ma non c'è un battito da inviare, quindi non vengono inviati frame. Avvia l'app dell'orologio, inserisci AirPods Pro 3 o imposta la fonte su Test."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "^[%lld 台のデバイス](inflect: true) に接続済みですが、送信する心拍数データがないため、フレームが送信されていません。ウォッチアプリを起動するか、AirPods Pro 3 を装着するか、ソースをテストに設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "^[%lld개 장치](inflect: true)에 연결되었지만 전송할 심박수가 없어 프레임이 전송되지 않습니다. 시계 앱을 시작하거나 AirPods Pro 3를 착용하거나 소스를 테스트로 설정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilkoblet ^[%lld enhet](inflect: true), men det er ingen hjertefrekvens å sende, så ingen rammer sendes. Start klokkeappen, sett i AirPods Pro 3, eller angi kilden til Test."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbonden met ^[%lld apparaat](inflect: true), maar er is geen hartslag om te verzenden, dus er worden geen frames verzonden. Start de horloge-app, plaats AirPods Pro 3 of stel de bron in op Test."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połączono z ^[%lld urządzeniem](inflect: true), ale nie ma danych tętna, więc nie są wysyłane ramki. Uruchom aplikację na zegarku, podłącz AirPods Pro 3 lub ustaw źródło na Testowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectado a ^[%lld dispositivo](inflect: true), mas não há frequência cardíaca para enviar, portanto, nenhum quadro está sendo transmitido. Inicie o aplicativo do relógio, insira os AirPods Pro 3 ou defina a fonte como Teste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключено к ^[%lld устройству](inflect: true), но отправлять частоту сердечных сокращений нечего, поэтому кадры не передаются. Запустите приложение на часах, подключите AirPods Pro 3 или установите источник в положение «Тест»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ansluten till ^[%lld enhet](inflect: true), men det finns inget hjärtslagsvärde att skicka, så inga ramar skickas. Starta klockappen, sätt i AirPods Pro 3 eller ange källa till Test."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เชื่อมต่ออยู่กับ ^[%lld อุปกรณ์](inflect: true) แต่ไม่มีอัตราการเต้นของหัวใจให้ส่ง จึงไม่มีการส่งเฟรม เริ่มแอปบนนาฬิกา ใส่ AirPods Pro 3 หรือตั้งค่าแหล่งข้อมูลเป็นการทดสอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "^[%lld aygıta](inflect: true) bağlandı, ancak gönderilecek bir kalp atış hızı yok, bu nedenle kareler gönderilmiyor. Saat uygulamasını başlatın, AirPods Pro 3 takın veya kaynağı Test olarak ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підключено до ^[%lld пристрою](inflect: true), але надсилати пульс неможливо, тому кадри не надходять. Запустіть додаток для годинника, вставте AirPods Pro 3 або встановіть джерело на «Тест»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã kết nối với ^[%lld thiết bị](inflect: true), nhưng không có nhịp tim để gửi nên không có khung nào được phát đi. Hãy mở ứng dụng đồng hồ, đưa AirPods Pro 3 vào tai hoặc đặt nguồn thành Thử nghiệm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已连接 ^[%lld 台设备](inflect: true)，但尚未有心率数据可发送，因此无帧数据发出。请启动手表应用，佩戴 AirPods Pro 3，或将来源设置为测试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已連線至 ^[%lld 個裝置](inflect: true)，但沒有心率資料可傳送，因此不會輸出任何資料幀。請啟動手錶應用程式、放入 AirPods Pro 3，或將來源設為測試。"
          }
        }
      }
    },
