    "Estimated from heart rate — no power meter reporting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدير من معدل ضربات القلب — لا يوجد مقياس قدرة يرسل بيانات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad z tepové frekvence — žádný měřič výkonu nehlásí data."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimeret ud fra pulsen — ingen effektmåler sender data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der Herzfrequenz geschätzt — kein Leistungsmesser sendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado a partir de la frecuencia cardíaca: ningún medidor de potencia está enviando datos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado a partir de la frecuencia cardiaca: ningún medidor de potencia está enviando datos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvioitu sykkeestä — yksikään tehomittari ei lähetä tietoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimé d’après la fréquence cardiaque — aucun capteur de puissance ne transmet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperkirakan dari detak jantung — tidak ada power meter yang mengirim data."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimato dalla frequenza cardiaca — nessun misuratore di potenza sta trasmettendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍数からの推定です（パワーメーターのデータがありません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심박수로 추정한 값입니다 — 파워미터 데이터가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimert ut fra pulsen — ingen effektmåler sender data."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschat op basis van de hartslag — geen vermogensmeter actief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszacowane na podstawie tętna — żaden miernik mocy nie przesyła danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado pela frequência cardíaca — nenhum medidor de potência transmitindo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка по пульсу — измеритель мощности не передаёт данные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppskattat utifrån pulsen — ingen effektmätare skickar data."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประมาณจากอัตราการเต้นหัวใจ — ไม่มีพาวเวอร์มิเตอร์ส่งข้อมูล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalp atış hızından tahmin edildi — veri gönderen bir güç ölçer yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінка за пульсом — вимірювач потужності не передає дані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước tính từ nhịp tim — không có đồng hồ công suất nào gửi dữ liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据心率估算 — 没有功率计在传输数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據心率估算 — 沒有功率計在傳送資料。"
          }
        }
      }
    },
