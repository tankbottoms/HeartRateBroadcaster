    "Rough estimate — fill in your body details for a better figure.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدير تقريبي — أدخل بيانات جسمك للحصول على رقم أدق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hrubý odhad — vyplňte tělesné údaje pro přesnější číslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Groft estimat — udfyld dine kropsdata for et bedre tal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grobe Schätzung — trage deine Körperdaten ein, dann stimmt der Wert besser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
