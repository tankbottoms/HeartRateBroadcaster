    "Relays your heart rate to bike computers and fitness apps as a standard Bluetooth heart rate monitor.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعيد بث معدل ضربات القلب الخاص بك إلى أجهزة حواسيب الدراجات والتطبيقات الرياضية كمستشعر معدل ضربات قلب قياسي عبر Bluetooth."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přenáší vaši tepovou frekvenci na cyklopočítače a fitness aplikace jako standardní Bluetooth senzor tepové frekvence."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Videresender din puls til cykelcomputere og fitness-apps som en standard Bluetooth-puls-sensor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Überträgt deine Herzfrequenz an Fahrradcomputer und Fitness-Apps als standardmäßigen Bluetooth-Herzfrequenzmesser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retransmite tu frecuencia cardíaca a ordenadores de ciclismo y aplicaciones de fitness como un monitor de frecuencia cardíaca Bluetooth estándar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retransmite tu frecuencia cardíaca a computadoras de ciclismo y aplicaciones de fitness como un monitor de frecuencia cardíaca Bluetooth estándar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lähetä syketietosi pyörätietokoneille ja kunto-ohjelmistoille standardin Bluetooth-syketunnistimen tavoin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transmet votre fréquence cardiaque aux ordinateurs de vélo et aux applications de fitness en tant que capteur de fréquence cardiaque Bluetooth standard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menyiarikan detak jantung Anda ke komputer sepeda dan aplikasi kebugaran sebagai monitor detak jantung Bluetooth standar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trasmetti la tua frequenza cardiaca a computer da bici e app fitness come un normale monitor della frequenza cardiaca Bluetooth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "標準のBluetooth心拍モニターとして、バイクコンピュータやフィットネスアプリに心拍を中継します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "표준 Bluetooth 심박 모니터로 자전거 컴퓨터 및 피트니스 앱에 심박 데이터를 중계합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sender pulsen din til sykledatorer og treningsapper som en standard Bluetooth-pulssensor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doorstroomt je hartslag naar fietscomputers en fitness-apps als een standaard Bluetooth-hartslagmeter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przekazuje Twoje tętno do komputerów rowerowych i aplikacji fitness jako standardowy czujnik tętna Bluetooth."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transmite sua frequência cardíaca para ciclocomputadores e aplicativos de fitness como um monitor de frequência cardíaca Bluetooth padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Передаёт данные о частоте сердечных сокращений на велокомпьютеры и фитнес-приложения в виде стандартного Bluetooth-датчика ЧСС."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sänder din puls till cykldatorer och träningsappar som en standard Bluetooth-pulsmätare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ส่งต่ออัตราการเต้นของหัวใจของคุณไปยังคอมพิวเตอร์จักรยานและแอปฟิตเนสในฐานะเครื่องวัดอัตราการเต้นของหัวใจแบบ Bluetooth มาตรฐาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kalp atış hızınızı standart bir Bluetooth kalp atış hızı monitörü olarak bisikter bilgisayarlarına ve fitness uygulamalarına iletir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Передає частоту серцевих скорочень на велокомп’ютери та фітнес-додатки як стандартний Bluetooth-датчик частоти серцевих скорочень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phát lại nhịp tim của bạn cho máy tính xe đạp và các ứng dụng thể dục như một máy đo nhịp tim Bluetooth tiêu chuẩn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将您的心率作为标准蓝牙心率监测器，中继传输至码表和健身应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將您的心率以標準藍牙心率感應器的方式，轉傳至自行車電腦與健身應用程式。"
          }
        }
      }
    },
