    "Broadcasting uses the Bluetooth peripheral role. Denying Bluetooth stops the app being visible to any head unit, regardless of the heart rate source.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يستخدم البث دور الطرفية في البلوتوث. يمنع رفض البلوتوث ظهور التطبيق لأي وحدة رأس، بغض النظر عن مصدر معدل ضربات القلب."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vysílání využívá roli periferního zařízení Bluetooth. Odepření přístupu k Bluetooth zastaví viditelnost aplikace pro jakoukoli hlavici jednotky, bez ohledu na zdroj tepové frekvence."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Udsendelse bruger Bluetooth-perifer rollen. Hvis du nægter Bluetooth, bliver appen usynlig for alle hovedenheder, uanset hjertefrekvenskilde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Broadcasting nutzt die Bluetooth-Peripherierolle. Die Verweigerung von Bluetooth verhindert, dass die App für Head-Units sichtbar ist, unabhängig von der Herzfrequenzquelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La transmisión utiliza el rol de periférico de Bluetooth. Denegar Bluetooth impide que la aplicación sea visible para cualquier unidad principal, independientemente de la fuente de frecuencia cardíaca."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La transmisión utiliza el rol de periférico de Bluetooth. Denegar Bluetooth impide que la aplicación sea visible para cualquier unidad principal, independientemente de la fuente de frecuencia cardíaca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lähetys käyttää Bluetoothin perifeeristä roolia. Bluetoothin evääminen estää sovelluksen näkyvyyden millekään pääyksikölle riippumatta sykkeen lähteestä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La diffusion utilise le rôle périphérique Bluetooth. Refuser l’accès Bluetooth empêche l’application d’être visible par toute unité centrale, quelle que soit la source de fréquence cardiaque."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siaran menggunakan peran periferal Bluetooth. Menolak Bluetooth menghentikan aplikasi terlihat oleh unit kepala mana pun, terlepas dari sumber detak jantung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La trasmissione utilizza il ruolo periferico di Bluetooth. Il rifiuto di Bluetooth impedisce all'app di essere visibile a qualsiasi unità principale, indipendentemente dalla fonte del battito cardiaco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブロードキャストには Bluetooth の周辺機器モードが使用されます。Bluetooth を拒否すると、心拍数のソースに関係なく、アプリがどのヘッドユニットからも表示されなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "방송은 블루투스 주변 장치 역할을 사용합니다. 블루투스를 거부하면 심박수 소스와 관계없이 헤드 유닛이 앱을 볼 수 없게 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kringkasting bruker Bluetooth-perifer-rollen. Å nekte Bluetooth stopper at appen er synlig for noen hodeenhet, uavhengig av hjertefrekvenskilde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uitzenden gebruikt de Bluetooth-peripheralrol. Het weigeren van Bluetooth zorgt ervoor dat de app niet zichtbaar is voor enige head unit, ongeacht de hartslagsensor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nadawanie wykorzystuje tryb peryferyjny Bluetooth. Odmowa dostępu do Bluetooth uniemożliwia widoczność aplikacji dla dowolnego komputera rowerowego, niezależnie od źródła sygnału tętna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A transmissão usa o papel de periférico do Bluetooth. Negar o Bluetooth impede que o aplicativo seja visível para qualquer unidade de controle, independentemente da fonte de frequência cardíaca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Передача данных использует роль периферийного устройства Bluetooth. Запрет доступа к Bluetooth делает приложение невидимым для любых головных устройств, независимо от источника данных о частоте сердечных сокращений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sändning använder Bluetooth-periferiläget. Om Bluetooth nekas blir appen osynlig för alla huvudenheter, oavsett hjärtfrekvenskälla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การส่งสัญญาณใช้บทบาทเพอริเฟอรัลบลูทูธ การปฏิเสธบลูทูธจะทำให้แอปไม่ปรากฏต่อหน่วยหลักใดๆ ไม่ว่าแหล่งข้อมูลอัตราการเต้นของหัวใจจะเป็นอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yayın, Bluetooth çevresel rolünü kullanır. Bluetooth reddedildiğinde, kalp atışı kaynağı ne olursa olsun, uygulama herhangi bir başlık ünitesi tarafından görünmez hale gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Передача даних використовує роль периферійного пристрою Bluetooth. Заборона доступу до Bluetooth робить додаток непомітним для будь-якого головного пристрою, незалежно від джерела частоти серцевих скорочень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quảng bá sử dụng vai trò thiết bị ngoại vi Bluetooth. Việc từ chối Bluetooth sẽ khiến ứng dụng không hiển thị với bất kỳ đầu thu nào, bất kể nguồn nhịp tim là gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "广播使用蓝牙外围设备角色。拒绝蓝牙访问将导致应用对任何车机头显不可见，无论心率数据来源为何。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "廣播使用藍牙週邊模式。拒絕藍牙存取權限會使應用程式對任何頭部單元都不可見，無論心率來源為何。"
          }
        }
      }
    },
