# Copy to web/.env — gitignored — and fill in. Wrangler reads both of these from
# the environment, so `bunx wrangler deploy` picks them up with no flags.
#
# The account id is not a secret (it appears in every dashboard URL) but it does
# identify the account, so it stays out of the committed wrangler.toml. Find it
# with `bunx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=

# Only needed for non-interactive deploys. Leave empty to use `wrangler login`.
CLOUDFLARE_API_TOKEN=
