    "Open Heart Rate Broadcaster on iPhone. The phone does the Bluetooth broadcasting; the watch only supplies heart rate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Heart Rate Broadcaster على iPhone. الهاتف هو الذي يبث عبر البلوتوث، والساعة تزوّده بنبض القلب فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete Heart Rate Broadcaster na iPhonu. Vysílání přes Bluetooth obstarává telefon, hodinky jen dodávají tepovou frekvenci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Heart Rate Broadcaster på din iPhone. Telefonen står for Bluetooth-udsendelsen; uret leverer kun pulsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Heart Rate Broadcaster auf dem iPhone. Das Senden per Bluetooth übernimmt das iPhone; die Uhr liefert nur die Herzfrequenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Heart Rate Broadcaster en el iPhone. El teléfono se encarga de la emisión Bluetooth; el reloj solo aporta la frecuencia cardíaca."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Heart Rate Broadcaster en el iPhone. El teléfono se encarga de la transmisión Bluetooth; el reloj solo aporta la frecuencia cardiaca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Heart Rate Broadcaster iPhonessa. Puhelin hoitaa Bluetooth-lähetyksen, kello vain toimittaa sykkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Heart Rate Broadcaster sur l’iPhone. C’est le téléphone qui émet en Bluetooth ; la montre ne fournit que la fréquence cardiaque."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Heart Rate Broadcaster di iPhone. Ponsel yang menyiarkan lewat Bluetooth; jam tangan hanya memasok detak jantung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Heart Rate Broadcaster su iPhone. È il telefono a trasmettere via Bluetooth; l’orologio fornisce solo la frequenza cardiaca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone で Heart Rate Broadcaster を開いてください。Bluetooth で送信するのは iPhone で、時計は心拍数を渡すだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 Heart Rate Broadcaster를 여세요. Bluetooth 송신은 아이폰이 하고, 시계는 심박수만 공급합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Heart Rate Broadcaster på iPhone. Telefonen står for Bluetooth-sendingen; klokken leverer bare pulsen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Heart Rate Broadcaster op de iPhone. De telefoon verzorgt de Bluetooth-uitzending; het horloge levert alleen de hartslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Heart Rate Broadcaster na iPhonie. To telefon nadaje przez Bluetooth, a zegarek jedynie dostarcza tętno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Heart Rate Broadcaster no iPhone. É o telefone que transmite por Bluetooth; o relógio só fornece a frequência cardíaca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Heart Rate Broadcaster на iPhone. Передачу по Bluetooth ведёт телефон, часы лишь поставляют пульс."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Heart Rate Broadcaster på iPhone. Telefonen sköter Bluetooth-sändningen; klockan levererar bara pulsen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Heart Rate Broadcaster บน iPhone โทรศัพท์เป็นตัวกระจายสัญญาณ Bluetooth ส่วนนาฬิกาแค่ส่งอัตราการเต้นหัวใจให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’da Heart Rate Broadcaster’ı açın. Bluetooth yayınını telefon yapar; saat yalnızca kalp atış hızını sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Heart Rate Broadcaster на iPhone. Передавання через Bluetooth веде телефон, годинник лише постачає пульс."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở Heart Rate Broadcaster trên iPhone. Điện thoại mới là thứ phát qua Bluetooth; đồng hồ chỉ cung cấp nhịp tim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iPhone 上打开 Heart Rate Broadcaster。蓝牙广播由手机负责，手表只提供心率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iPhone 上開啟 Heart Rate Broadcaster。藍牙廣播由手機負責，手錶只提供心率。"
          }
        }
      }
    },
